---
import BaseLayout from "../layouts/BaseLayout.astro";
import BrandMark from "../components/BrandMark.astro";
import AuditPulseVisual from "../components/AuditPulseVisual.astro";
import { highlightCode } from "../lib/highlight";
import "../styles/landing.css";

const prismaRaw = `import { PrismaClient } from "@prisma/client";
import { PrismaPg } from "@prisma/adapter-pg";
import { audit } from "@auditstream/node";
import { auditstream } from "@auditstream/prisma";

const db = new PrismaClient({
  adapter: new PrismaPg(pool),
  comments: [auditstream()],
});

await audit.as(
  {
    type: "ai_agent",
    id: "billing-agent",
    onBehalfOf: { type: "user", id: "usr_42" },
  },
  () =>
    db.invoice.update({
      where: { id: "inv_901" },
      data: { status: "paid" },
    })
);`;

const drizzleRaw = `import { drizzle } from "drizzle-orm/node-postgres";
import { eq } from "drizzle-orm";
import { audit } from "@auditstream/node";
import { wrapPgPool } from "@auditstream/drizzle/pg";
import { invoice } from "./schema";

const db = drizzle({ client: wrapPgPool(pool) });

await audit.as(
  {
    type: "ai_agent",
    id: "billing-agent",
    onBehalfOf: { type: "user", id: "usr_42" },
  },
  () =>
    db
      .update(invoice)
      .set({ status: "paid" })
      .where(eq(invoice.id, "inv_901"))
);`;

const sqlRaw = `-- App role has SELECT only; triggers log writes
UPDATE invoice SET status = 'paid' WHERE id = 'inv_901'
/*auditstream='eyJ0eXBlIjoiYWlf…'*/;

SELECT xact_id, occurred_at, actor,
       changed, before, after
FROM   auditstream.changes
WHERE  table_name = 'invoice'
  AND  record_id = '{"id":"inv_901"}'::jsonb
ORDER BY xact_id DESC;`;

const [prismaHtml, drizzleHtml, sqlHtml] = await Promise.all([
  highlightCode(prismaRaw, "ts", { lineNumbers: true }),
  highlightCode(drizzleRaw, "ts", { lineNumbers: true }),
  highlightCode(sqlRaw, "sql", { lineNumbers: true, highlightAuditComment: true }),
]);

const adapterTabs = [
  { key: "prisma", label: "Prisma 7", html: prismaHtml },
  { key: "drizzle", label: "Drizzle", html: drizzleHtml },
  { key: "sql", label: "Plain SQL", html: sqlHtml },
];

const initCmd =
  "auditstream init --migrations prisma --table public.invoice \\\n  --exclude public.users.password_hash";
const exportCmd =
  "auditstream export --format jsonl --output audit.jsonl \\\n  --cursor-file cursor.json";
const shellInstallDisplay =
  "BASE=https://github.com/auditstream/auditstream/releases/latest/download\ncurl --proto '=https' --tlsv1.2 -LsSf \"$BASE/auditstream-installer.sh\" | sh";
const shellInstallCopy =
  "curl --proto '=https' --tlsv1.2 -LsSf https://github.com/auditstream/auditstream/releases/latest/download/auditstream-installer.sh | sh";

const installSnippets = [
  {
    key: "brew",
    label: "Homebrew",
    display: `brew install auditstream/tap/auditstream\n${initCmd}\n${exportCmd}`,
    copy: `brew install auditstream/tap/auditstream\nauditstream init --migrations prisma --table public.invoice --exclude public.users.password_hash\nauditstream export --format jsonl --output audit.jsonl --cursor-file cursor.json`,
  },
  {
    key: "shell",
    label: "Shell",
    display: `${shellInstallDisplay}\n${initCmd}\n${exportCmd}`,
    copy: `${shellInstallCopy}\nauditstream init --migrations prisma --table public.invoice --exclude public.users.password_hash\nauditstream export --format jsonl --output audit.jsonl --cursor-file cursor.json`,
  },
  {
    key: "npm",
    label: "npm",
    display: `npm install -g auditstream\n${initCmd}\n${exportCmd}`,
    copy: `npm install -g auditstream\nauditstream init --migrations prisma --table public.invoice --exclude public.users.password_hash\nauditstream export --format jsonl --output audit.jsonl --cursor-file cursor.json`,
  },
  {
    key: "docker",
    label: "Docker",
    display: `docker pull ghcr.io/auditstream/auditstream:0.1.0\ndocker run --rm -e DATABASE_URL ghcr.io/auditstream/auditstream:0.1.0 \\\n  init --table public.invoice\ndocker run --rm -e DATABASE_URL ghcr.io/auditstream/auditstream:0.1.0 \\\n  export --format jsonl`,
    copy: `docker pull ghcr.io/auditstream/auditstream:0.1.0\ndocker run --rm -e DATABASE_URL ghcr.io/auditstream/auditstream:0.1.0 init --table public.invoice\ndocker run --rm -e DATABASE_URL ghcr.io/auditstream/auditstream:0.1.0 export --format jsonl`,
  },
];

const installTabs = await Promise.all(
  installSnippets.map(async (item) => ({
    ...item,
    html: await highlightCode(item.display, "bash", { lineNumbers: true }),
  }))
);

const heroInstallCmd = "brew install auditstream/tap/auditstream";
---

<BaseLayout
  title="Auditstream — Open-source database audit trail engine"
  description="Open-source database audit trail engine written in Rust. Zero daemons, pooler-safe actors, and tamper-proof diffs."
  currentPath="/"
  showProgress={true}
>
  <main id="main-content" class="landing-main">
    <!-- Block 1: Centered Airy Hero + Retina Micro-Motion Focal Visual -->
    <section class="hero">
      <div class="shell hero-shell">
        <div class="hero-lockup">
          <h1 class="hero-title">
            Every row changed.<br />
            Enforced at the database.
          </h1>
          <p class="lead hero-sub">
            Open-source database audit trail engine written in Rust.<br class="hero-br" />
            Zero daemons, pooler-safe actors, and tamper-proof diffs.
          </p>

          <div class="hero-actions">
            <a href="/docs/getting-started/" class="btn btn-primary">Get Started</a>
            <a href="https://github.com/auditstream/auditstream" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
              GitHub <span aria-hidden="true">↗</span>
            </a>
          </div>

          <div class="install-chip">
            <span class="install-prompt" aria-hidden="true">$</span>
            <code class="install-cmd">{heroInstallCmd}</code>
            <button type="button" class="chip-btn is-compact install-copy" data-copy={heroInstallCmd} aria-label="Copy Homebrew install command">Copy</button>
          </div>
        </div>

        <AuditPulseVisual />
      </div>
    </section>

    <!-- Block 2: Three Core Pillars (Borderless Architectural Hairlines) -->
    <section class="section" aria-label="Core architecture">
      <div class="shell">
        <div class="pillars-grid">
          <div class="pillar">
            <h2 class="pillar-title">Zero new infrastructure</h2>
            <p class="pillar-body">
              Generated database triggers and a <strong class="pillar-em">commit-safe</strong>
              export cursor replace 24/7 consumers and replication slots.
            </p>
          </div>

          <div class="pillar">
            <h2 class="pillar-title">Safe behind every pooler</h2>
            <p class="pillar-body">
              Actors travel in trailing SQL comments (AI agents
              <code class="ic">onBehalfOf</code> users), with <strong class="pillar-em">0 leaks</strong> across
              2.4M PgBouncer transactions.
            </p>
          </div>

          <div class="pillar">
            <h2 class="pillar-title">Tamper-evident by default</h2>
            <p class="pillar-body">
              Application roles receive <strong class="pillar-em">SELECT only</strong> (<code class="ic">ERROR 42501</code> on
              UPDATE/DELETE), with continuous schema drift checks via
              <code class="ic">auditstream verify</code>.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Block 3: Clean Code Showcase -->
    <section class="section section-ruled">
      <div class="shell code-split">
        <div class="code-copy">
          <h2 class="h2">Four lines to attribute every write.</h2>
          <p class="lead code-lead">
            Wrap a request or tool call in <code class="ic">audit.as()</code>. Thin adapters attach
            the actor to outgoing SQL, and database triggers capture before/after diffs inside the
            same transaction.
          </p>
          <div class="text-links">
            <a href="/docs/typescript/" class="text-link">TypeScript SDK (Prisma, Drizzle, Next.js) →</a>
            <a href="/docs/python/" class="text-link">Python (no SDK yet — works via psycopg today) →</a>
            <a href="/docs/plain-sql/" class="text-link">Any language via plain SQL →</a>
          </div>
        </div>

        <div class="surface-frame">
          <div class="surface-bar">
            <div class="tabs" id="adapter-tabs" role="tablist" aria-label="Adapter code examples">
              {adapterTabs.map((t, i) => (
                <button
                  type="button" class="tab" role="tab" id={`tab-${t.key}`} data-tab={t.key}
                  aria-selected={i === 0 ? "true" : "false"} aria-controls={`panel-${t.key}`} tabindex={i === 0 ? 0 : -1}
                >{t.label}</button>
              ))}
            </div>
            <button type="button" class="chip-btn is-compact" data-copy-target="#adapter-panels" aria-label="Copy active code snippet">
              Copy
            </button>
          </div>

          <div class="panel-stack" id="adapter-panels">
            {adapterTabs.map((t, i) => (
              <div
                id={`panel-${t.key}`} role="tabpanel" aria-labelledby={`tab-${t.key}`} data-panel={t.key}
                data-active={i === 0 ? "true" : "false"} aria-hidden={i === 0 ? undefined : "true"} inert={i === 0 ? undefined : true}
                set:html={t.html}
              />
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Block 4: Measured Proof (Subtle Tonal Band) -->
    <section class="section section-proof">
      <div class="shell">
        <h2 class="h2">Measured on PostgreSQL 19. Honest limits.</h2>

        <div class="proof-grid">
          <div class="proof-item">
            <div class="proof-metric">+3.2%</div>
            <div class="proof-label">Single-row UPDATE overhead</div>
            <p class="proof-desc">
              +5.1&nbsp;µs/row on durable disk (<code class="ic">fsync=on</code>).
            </p>
          </div>

          <div class="proof-item">
            <div class="proof-metric">2.4M</div>
            <div class="proof-label">Pooled transactions</div>
            <p class="proof-desc">
              PgBouncer 1.26 · 0&nbsp;failed, 0&nbsp;leaked actors.
            </p>
          </div>

          <div class="proof-item">
            <div class="proof-metric">0.101 ms</div>
            <div class="proof-label">Single-record lookup</div>
            <p class="proof-desc">
              Across 500,000&nbsp;rows (157k&nbsp;concurrent&nbsp;QPS).
            </p>
          </div>

          <div class="proof-item">
            <div class="proof-metric">~15k/s</div>
            <div class="proof-label">Bulk UPDATE ceiling</div>
            <p class="proof-desc">
              Row-level by design. <span class="nowrap">Bulk INSERT/DELETE</span> reach 211k/s.
            </p>
          </div>
        </div>

        <div class="proof-foot">
          <div class="proof-links">
            <a href="/docs/evidence/" class="text-link proof-link">Read full benchmarks →</a>
            <a href="/docs/compare/" class="text-link">Compare vs. pgaudit &amp; Debezium →</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Block 5: Simple 3-Step Quickstart -->
    <section class="section" id="quickstart">
      <div class="shell qs-shell">
        <div class="qs-head">
          <h2 class="h2">Up and running in 60 seconds.</h2>
          <a href="/docs/getting-started/" class="text-link">Full Quickstart guide →</a>
        </div>

        <div class="surface-frame qs-frame">
          <div class="surface-bar">
            <div class="tabs" id="install-tabs" role="tablist" aria-label="Install methods">
              {installTabs.map((t, i) => (
                <button
                  type="button" class="tab" role="tab" id={`tab-${t.key}`} data-tab={t.key}
                  aria-selected={i === 0 ? "true" : "false"} aria-controls={`panel-${t.key}`} tabindex={i === 0 ? 0 : -1}
                >{t.label}</button>
              ))}
            </div>
            <button type="button" class="chip-btn is-compact" data-copy-target="#install-panels" aria-label="Copy quickstart commands">
              Copy
            </button>
          </div>

          <div class="panel-stack" id="install-panels">
            {installTabs.map((t, i) => (
              <div
                id={`panel-${t.key}`} role="tabpanel" aria-labelledby={`tab-${t.key}`} data-panel={t.key}
                data-active={i === 0 ? "true" : "false"} aria-hidden={i === 0 ? undefined : "true"} inert={i === 0 ? undefined : true}
                data-copy-override={t.copy} set:html={t.html}
              />
            ))}
          </div>
        </div>
      </div>
    </section>
  </main>

  <!-- Minimal Light Footer -->
  <footer class="site-footer">
    <div class="shell footer-inner">
      <div class="footer-brand-group">
        <a href="#top" class="brand"><BrandMark size={18} /><span>Auditstream</span></a>
        <span class="footer-meta">MIT License · Open-source</span>
      </div>

      <nav class="footer-links" aria-label="Footer">
        <a href="/docs/">Docs</a>
        <a href="/docs/evidence/">Benchmarks</a>
        <a href="https://github.com/auditstream/auditstream" target="_blank" rel="noopener noreferrer">Engine</a>
        <a href="https://github.com/auditstream/auditstream-js" target="_blank" rel="noopener noreferrer">JS SDK</a>
        <a href="https://github.com/auditstream/auditstream/releases" target="_blank" rel="noopener noreferrer">Releases</a>
        <a href="https://github.com/auditstream/auditstream/attestations" target="_blank" rel="noopener noreferrer">SLSA Attested</a>
        <a href="https://sonarcloud.io/project/overview?id=auditstream_auditstream" target="_blank" rel="noopener noreferrer">SonarCloud A</a>
        <a href="https://github.com/auditstream/auditstream/security/policy" target="_blank" rel="noopener noreferrer">Security</a>
      </nav>
    </div>
  </footer>
</BaseLayout>

<script>
  function wireTablist(tablistId: string, panelsId: string) {
    const tablist = document.getElementById(tablistId);
    const panelRoot = document.getElementById(panelsId);
    if (!tablist || !panelRoot) return;
    const tabs = Array.from(tablist.querySelectorAll<HTMLElement>('[role="tab"]'));
    const panels = Array.from(panelRoot.querySelectorAll<HTMLElement>('[role="tabpanel"]'));

    function activate(idx: number, moveFocus: boolean) {
      const key = tabs[idx]?.getAttribute("data-tab");
      tabs.forEach((t, i) => {
        t.setAttribute("aria-selected", String(i === idx));
        t.setAttribute("tabindex", i === idx ? "0" : "-1");
      });
      panels.forEach((p) => {
        const active = p.getAttribute("data-panel") === key;
        p.setAttribute("data-active", String(active));
        p.setAttribute("aria-hidden", String(!active));
        p.inert = !active;
      });
      if (moveFocus) tabs[idx]?.focus();
    }

    tabs.forEach((tab, idx) => {
      tab.addEventListener("click", () => activate(idx, false));
      tab.addEventListener("keydown", (e) => {
        const next =
          e.key === "ArrowRight" ? (idx + 1) % tabs.length :
          e.key === "ArrowLeft" ? (idx - 1 + tabs.length) % tabs.length :
          e.key === "Home" ? 0 :
          e.key === "End" ? tabs.length - 1 : -1;
        if (next >= 0) {
          e.preventDefault();
          activate(next, true);
        }
      });
    });
  }

  wireTablist("adapter-tabs", "adapter-panels");
  wireTablist("install-tabs", "install-panels");
</script>
