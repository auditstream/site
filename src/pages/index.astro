  /* --------------------------------------------------------------------------
     1. Zero-CLS Linear Hero Width Refinement (only adjusts horizontal wdth —
        NEVER changes font-size after paint! 2 reads instead of 26 reflows!)
     -------------------------------------------------------------------------- */
  function setWidth(el, w) {
    const clamped = Math.max(75, Math.min(125, w));
    el.style.setProperty("--fit", clamped.toFixed(1) + "%");
    el.style.setProperty("--wdth", clamped.toFixed(1));
  }

  function fitHeroLines() {
    const box = document.getElementById("hero-fit-box");
    if (!box) return;
    const targetW = box.clientWidth * 0.996;
    if (!targetW) return;
    const lines = Array.from(box.querySelectorAll(".fit-line"));

    // Read widths in one batch before writing (avoids layout thrashing!)
    const initial = lines.map((el) => ({
      el,
      w: el.getBoundingClientRect().width,
      wdth: parseFloat(el.style.getPropertyValue("--wdth")) || 100,
    }));

    // Linear interpolation on Mona Sans wdth axis (slope ≈ 0.0046 per wdth unit)
    initial.forEach(({ el, w, wdth }) => {
      if (!w || Math.abs(w - targetW) < 2) return;
      const ratio = targetW / w;
      // Approximate next wdth linearly (wdth spans ~1.22x across 75..125)
      const next = wdth + (ratio - 1) * 215;
      setWidth(el, next);
    });

    // Single refinement pass
    const refined = lines.map((el) => ({
      el,
      w: el.getBoundingClientRect().width,
      wdth: parseFloat(el.style.getPropertyValue("--wdth")) || 100,
    }));
    refined.forEach(({ el, w, wdth }) => {
      if (!w || Math.abs(w - targetW) < 1.5) return;
      const delta = ((targetW / w) - 1) * 215;
      setWidth(el, wdth + delta);
    });
  }

  if (document.fonts && document.fonts.ready) {
    document.fonts.ready.then(fitHeroLines);
  }
  window.addEventListener("resize", fitHeroLines, { passive: true });

  /* Crisp opacity-only one-shot reveal (zero transform on text = zero blur!) */
  if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches && "IntersectionObserver" in window) {
    const nodes = Array.from(document.querySelectorAll(".reveal"));
    const vh = window.innerHeight;
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.remove("is-pending");
            io.unobserve(e.target);
          }
        }
      },
      { rootMargin: "0px 0px -6% 0px", threshold: 0.01 }
    );
    nodes.forEach((n) => {
      if (n.getBoundingClientRect().top > vh * 0.95) {
        n.classList.add("is-pending");
        io.observe(n);
      }
    });
  }

  /* --------------------------------------------------------------------------
     2. Hero 4-Stage Telemetry Replay (switches pre-rendered Shiki panels!)
     -------------------------------------------------------------------------- */
  const TRACE_META = [
    {
      title: "01 · Trailing sqlcommenter tag (base64url)",
      badge: "NO EXPLICIT TX",
      railX: 56,
      caption: 'Unpadded base64url can never contain <code class="ic">*/</code> or inject SQL. IDs only — no names, emails, or IPs leak into <code class="ic">pg_stat_activity</code>.',
    },
    {
      title: "02 · PostgreSQL trigger computes before & after",
      badge: "SECURITY DEFINER",
      railX: 245,
      caption: 'No-op updates and excluded-column-only edits write nothing. Malformed payloads store <code class="ic">actor = NULL</code> and never abort the write.',
    },
    {
      title: "03 · Committed to partitioned auditstream.changes",
      badge: "xact_id = 48291044",
      railX: 434,
      caption: 'Monthly-partitioned table owned by a <code class="ic">NOLOGIN</code> role. App roles get <code class="ic">SELECT</code> only — tamper writes are denied by Postgres.',
    },
    {
      title: "04 · Pull-based xid8 window export",
      badge: "ACK AFTER FLUSH",
      railX: 624,
      caption: 'Exports JSON Lines or CSV on demand with stable <code class="ic">event_id</code> deduplication — no 24/7 consumer and no WAL replication slot.',
    },
  ];

  let traceIdx = 0;
  let tracePaused = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const railActive = document.getElementById("rail-active");
  const traceNodes = Array.from(document.querySelectorAll(".t-node"));
  const traceToggle = document.getElementById("trace-toggle");

  function renderTrace(idx) {
    traceIdx = idx;
    const t = TRACE_META[idx];
    document.getElementById("trace-title").textContent = t.title;
    document.getElementById("trace-badge").textContent = t.badge;
    document.getElementById("trace-caption").innerHTML = t.caption;
    railActive?.setAttribute("x2", String(t.railX));

    document.querySelectorAll(".telemetry-panel").forEach((p, i) => {
      p.hidden = i !== idx;
    });
    traceNodes.forEach((g, i) => {
      const rect = g.querySelector("rect");
      const dot = g.querySelector("circle");
      const txt = g.querySelector("text");
      const lit = i <= idx;
      rect?.setAttribute("stroke", lit ? "var(--accent)" : "var(--rule-strong)");
      dot?.setAttribute("fill", lit ? "var(--accent)" : "var(--ink-3)");
      txt?.setAttribute("fill", i === idx ? "var(--ink)" : "var(--ink-3)");
    });
    document.querySelectorAll("#stage-tabs .stage-tab").forEach((b, i) => {
      b.setAttribute("data-active", String(i === idx));
    });
  }

  document.querySelectorAll("#stage-tabs .stage-tab").forEach((b) => {
    b.addEventListener("click", () => {
      renderTrace(Number(b.getAttribute("data-step")));
      tracePaused = true;
      if (traceToggle) traceToggle.textContent = "Play";
    });
  });
  if (traceToggle) {
    traceToggle.textContent = tracePaused ? "Play" : "Pause";
    traceToggle.addEventListener("click", () => {
      tracePaused = !tracePaused;
      traceToggle.textContent = tracePaused ? "Play" : "Pause";
    });
  }
  renderTrace(0);
  setInterval(() => {
    if (!tracePaused) renderTrace((traceIdx + 1) % TRACE_META.length);
  }, 3900);

  /* --------------------------------------------------------------------------
     3. Adapter Tabs & History Row 3-View Inspector
     -------------------------------------------------------------------------- */
  const ADAPTER_INFO = {
    prisma: { file: "@auditstream/prisma · auditstream() SQL comments plugin", raw: prismaRaw },
    drizzle: { file: "@auditstream/drizzle/pg · Drizzle 0.45 wrapper & 1.x auditComment()", raw: drizzleRaw },
    node: { file: "@auditstream/node · AsyncLocalStorage.run() & audit.log()", raw: nodeRaw },
  };

  document.querySelectorAll("[data-adapter]").forEach((tab) => {
    tab.addEventListener("click", () => {
      const key = tab.getAttribute("data-adapter");
      document.querySelectorAll("[data-adapter]").forEach((t) => t.setAttribute("aria-selected", String(t === tab)));
      document.querySelectorAll("[data-adapter-panel]").forEach((p) => {
        p.hidden = p.getAttribute("data-adapter-panel") !== key;
      });
      const info = ADAPTER_INFO[key];
      const fname = document.getElementById("adapter-filename");
      const copyBtn = document.getElementById("copy-adapter");
      if (fname && info) fname.textContent = info.file;
      if (copyBtn && info) copyBtn.setAttribute("data-copy", info.raw);
    });
  });

  document.querySelectorAll("[data-rowview]").forEach((tab) => {
    tab.addEventListener("click", () => {
      const key = tab.getAttribute("data-rowview");
      document.querySelectorAll("[data-rowview]").forEach((t) => t.setAttribute("aria-selected", String(t === tab)));
      document.querySelectorAll("[data-rowview-panel]").forEach((p) => {
        p.hidden = p.getAttribute("data-rowview-panel") !== key;
      });
    });
  });

  /* --------------------------------------------------------------------------
     4. Interactive xid8 Safe Horizon Proof (Run #1 vs Run #2)
     -------------------------------------------------------------------------- */
  function setHorizonRun(run) {
    const isRun2 = run === "2";
    document.querySelectorAll("[data-run]").forEach((b) => b.setAttribute("data-active", String(b.getAttribute("data-run") === run)));

    const lineGroup = document.getElementById("hz-line-group");
    const lineLabel = document.getElementById("hz-line-label");
    const badge = document.getElementById("hz-badge");
    const zone = document.getElementById("hz-zone");
    const zoneLbl = document.getElementById("hz-zone-lbl");
    const bar42 = document.getElementById("bar-tx42");
    const dot42 = document.getElementById("dot-tx42");
    const txt42 = document.getElementById("txt-tx42");
    const lbl42 = document.getElementById("lbl-tx42");
    const bar43 = document.getElementById("bar-tx43");
    const dot43 = document.getElementById("dot-tx43");
    const txt43 = document.getElementById("txt-tx43");
    const bar44 = document.getElementById("bar-tx44");
    const dot44 = document.getElementById("dot-tx44");
    const txt44 = document.getElementById("txt-tx44");
    const exp = document.getElementById("hz-explanation");

    if (!isRun2) {
      lineGroup?.setAttribute("transform", "translate(0, 0)");
      if (lineLabel) lineLabel.textContent = "xmin = 48291042";
      if (badge) badge.textContent = "HORIZON: xact_id < 48291042";
      zone?.setAttribute("width", "360");
      zone?.setAttribute("height", "44");
      zoneLbl?.setAttribute("x", "510");

      bar42?.setAttribute("fill", "rgba(230,179,90,0.16)");
      bar42?.setAttribute("stroke", "#e6b35a");
      bar42?.setAttribute("stroke-dasharray", "5 3");
      dot42?.setAttribute("fill", "#e6b35a");
      txt42?.setAttribute("fill", "#e6b35a");
      if (txt42) txt42.textContent = "IN FLIGHT AT t2 — HOLDS xmin (COMMITS LATER AT t3)";
      lbl42?.setAttribute("fill", "var(--hold)");

      bar43?.setAttribute("fill", "rgba(107,166,255,0.15)");
      bar43?.setAttribute("stroke", "#6ba6ff");
      dot43?.setAttribute("fill", "#6ba6ff");
      if (txt43) txt43.textContent = "COMMITTED · WAITS FOR HORIZON";

      bar44?.setAttribute("fill", "rgba(107,166,255,0.15)");
      bar44?.setAttribute("stroke", "#6ba6ff");
      dot44?.setAttribute("fill", "#6ba6ff");
      if (txt44) txt44.textContent = "invoice='paid' · WAITS";

      if (exp) {
        exp.innerHTML = `
          <div><strong>Proven in testing:</strong> A cursor on <span class="mono">id &gt; last_id</span> lost a row when <span class="mono">xid 42</span> committed after <span class="mono">xid 43</span> and <span class="mono">xid 44</span>.</div>
          <div><strong>Lossless xid8 window:</strong> Run #1 stops cleanly at <span class="mono">xact_id &lt; pg_snapshot_xmin() (48291042)</span>. Click <strong>Run #2</strong> above to watch <span class="mono">xid 42, 43, 44</span> flush in order with stable <span class="mono">event_id</span> deduplication.</div>
        `;
      }
    } else {
      lineGroup?.setAttribute("transform", "translate(335, 0)");
      if (lineLabel) lineLabel.textContent = "xmin = 48291045";
      if (badge) badge.textContent = "HORIZON: xact_id < 48291045";
      zone?.setAttribute("width", "695");
      zone?.setAttribute("height", "173");
      zoneLbl?.setAttribute("x", "845");

      bar42?.setAttribute("fill", "rgba(52,211,153,0.18)");
      bar42?.setAttribute("stroke", "#34d399");
      bar42?.removeAttribute("stroke-dasharray");
      dot42?.setAttribute("fill", "#34d399");
      txt42?.setAttribute("fill", "#e9f2fb");
      if (txt42) txt42.textContent = "COMMITTED AT t3 · EXPORTED IN BATCH #2 (NOT LOST!)";
      lbl42?.setAttribute("fill", "#34d399");

      bar43?.setAttribute("fill", "rgba(52,211,153,0.18)");
      bar43?.setAttribute("stroke", "#34d399");
      dot43?.setAttribute("fill", "#34d399");
      if (txt43) txt43.textContent = "EXPORTED IN BATCH #2";

      bar44?.setAttribute("fill", "rgba(52,211,153,0.18)");
      bar44?.setAttribute("stroke", "#34d399");
      dot44?.setAttribute("fill", "#34d399");
      if (txt44) txt44.textContent = "invoice='paid' · EXPORTED";

      if (exp) {
        exp.innerHTML = `
          <div><strong>Zero rows lost, at-least-once delivery:</strong> Once <span class="mono">xid 42</span> commits at <span class="mono">t3</span>, Run #2 sees <span class="mono">xmin = 48291045</span> and exports <span class="mono">xid 42, 43, 44</span> ordered by <span class="mono">xact_id, id</span>.</div>
          <div><strong>Zero WAL retention risk:</strong> The cursor is acknowledged only after the sink flushes — run every minute, hourly, or on demand without holding a replication slot open.</div>
        `;
      }
    }
  }

  document.querySelectorAll("[data-run]").forEach((b) => {
    b.addEventListener("click", () => setHorizonRun(b.getAttribute("data-run")));
  });
</script>
