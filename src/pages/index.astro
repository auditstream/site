<script define:vars={{ prismaRaw, drizzleRaw, middlewareRaw, nodeRaw, diffCopyRaw, cliHistoryRaw, querySqlRaw, jsonlRaw }}>
  /* Shared helper: toggle stacked zero-CLS panels via data-active + aria-hidden + inert */
  function setStackActive(items, predicate) {
    items.forEach((el, idx) => {
      const active = predicate(el, idx);
      el.setAttribute("data-active", String(active));
      el.setAttribute("aria-hidden", String(!active));
      el.inert = !active;
    });
  }

  /* Shared WAI-ARIA tablist keyboard wiring (ArrowLeft / ArrowRight / Home / End + roving tabindex) */
  function wireTablist(tablistEl, onSelect) {
    if (!tablistEl) return;
    const tabs = Array.from(tablistEl.querySelectorAll('[role="tab"]'));
    function activate(idx, moveFocus) {
      tabs.forEach((t, i) => {
        const selected = i === idx;
        t.setAttribute("aria-selected", String(selected));
        t.setAttribute("tabindex", selected ? "0" : "-1");
      });
      if (moveFocus) tabs[idx]?.focus();
      onSelect(tabs[idx], idx);
    }
    tabs.forEach((tab, idx) => {
      tab.addEventListener("click", () => activate(idx, false));
      tab.addEventListener("keydown", (e) => {
        let next = -1;
        if (e.key === "ArrowRight") next = (idx + 1) % tabs.length;
        else if (e.key === "ArrowLeft") next = (idx - 1 + tabs.length) % tabs.length;
        else if (e.key === "Home") next = 0;
        else if (e.key === "End") next = tabs.length - 1;
        if (next >= 0) {
          e.preventDefault();
          activate(next, true);
        }
      });
    });
  }

  /* --------------------------------------------------------------------------
     1. Crisp opacity-only one-shot reveal (zero transform on text = zero blur!)
        Hero H1 uses pure CSS container queries — zero runtime fitHeroLines() JS!
     -------------------------------------------------------------------------- */
  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (!prefersReducedMotion && "IntersectionObserver" in window) {
    const nodes = Array.from(document.querySelectorAll(".reveal"));
    const vh = window.innerHeight;
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.remove("is-pending");
            io.unobserve(e.target);
          }
        }
      },
      { rootMargin: "0px 0px -6% 0px", threshold: 0.01 }
    );
    nodes.forEach((n) => {
      if (n.getBoundingClientRect().top > vh * 0.95) {
        n.classList.add("is-pending");
        io.observe(n);
      }
    });
  }

  /* --------------------------------------------------------------------------
     2. Unified Hero Telemetry Stepper (stroke-dashoffset rail + packet pulse +
        synced ledger-strip + hover/focus/offscreen auto-pause)
     -------------------------------------------------------------------------- */
  const TRACE_META = [
    { title: "01 · Trailing sqlcommenter tag (base64url)", badge: "NO EXPLICIT TX", dashOffset: 510, pktTo: 28 },
    { title: "02 · PostgreSQL trigger computes before & after", badge: "SECURITY DEFINER", dashOffset: 340, pktTo: -170 },
    { title: "03 · Committed to auditstream.changes", badge: "xact_id = 48291044", dashOffset: 170, pktTo: -340 },
    { title: "04 · Pull-based xid8 window export", badge: "ACK AFTER FLUSH", dashOffset: 0, pktTo: -510 },
  ];

  let traceIdx = 0;
  let tracePaused = prefersReducedMotion;
  let heroInView = true;
  let heroHoverOrFocus = false;
  let traceTimer = 0;
  const heroPlate = document.getElementById("hero-telemetry");
  const railActive = document.getElementById("rail-active");
  const railPacket = document.getElementById("rail-packet");
  const traceNodes = Array.from(document.querySelectorAll(".t-node"));
  const traceToggle = document.getElementById("trace-toggle");
  const tracePanels = Array.from(document.querySelectorAll(".telemetry-panel"));
  const traceCaptions = Array.from(document.querySelectorAll("[data-caption]"));
  const ledgerRows = Array.from(document.querySelectorAll("[data-ledger]"));
  const stageTabs = Array.from(document.querySelectorAll("#stage-tabs .stage-tab"));

  function restartTraceTimer() {
    clearInterval(traceTimer);
    traceTimer = window.setInterval(() => {
      if (!tracePaused && heroInView && !heroHoverOrFocus) {
        renderTrace((traceIdx + 1) % TRACE_META.length, true);
      }
    }, 3900);
  }

  function renderTrace(idx, firePacket) {
    const prev = traceIdx;
    traceIdx = idx;
    const t = TRACE_META[idx];
    const titleEl = document.getElementById("trace-title");
    const badgeEl = document.getElementById("trace-badge");
    if (titleEl) titleEl.textContent = t.title;
    if (badgeEl) badgeEl.textContent = t.badge;
    if (railActive) railActive.style.strokeDashoffset = String(t.dashOffset);

    if (firePacket && !prefersReducedMotion && railPacket && idx !== prev) {
      railPacket.style.setProperty("--pkt-from", String(TRACE_META[prev].pktTo));
      railPacket.style.setProperty("--pkt-to", String(t.pktTo));
      railPacket.classList.remove("is-pulsing");
      void railPacket.getBoundingClientRect();
      railPacket.classList.add("is-pulsing");
    }

    setStackActive(tracePanels, (_el, i) => i === idx);
    setStackActive(traceCaptions, (_el, i) => i === idx);
    setStackActive(ledgerRows, (_el, i) => i === idx);

    traceNodes.forEach((g, i) => {
      const rect = g.querySelector("rect");
      const dot = g.querySelector("circle");
      const lit = i <= idx;
      rect?.setAttribute("stroke", lit ? "var(--accent)" : "var(--rule-strong)");
      dot?.setAttribute("fill", lit ? "var(--accent)" : "var(--ink-3)");
    });
    stageTabs.forEach((b, i) => {
      const active = i === idx;
      b.setAttribute("data-active", String(active));
      b.setAttribute("aria-selected", String(active));
      b.setAttribute("tabindex", active ? "0" : "-1");
      b.classList.remove("is-auto", "is-paused");
      if (active && !tracePaused && !prefersReducedMotion) {
        void b.offsetWidth;
        b.classList.add("is-auto");
        if (heroHoverOrFocus) b.classList.add("is-paused");
      }
    });
  }

  wireTablist(document.getElementById("stage-tabs"), (_tab, idx) => {
    tracePaused = true;
    if (traceToggle) traceToggle.textContent = "Play";
    renderTrace(idx, true);
  });

  traceNodes.forEach((g, idx) => {
    g.addEventListener("click", () => {
      tracePaused = true;
      if (traceToggle) traceToggle.textContent = "Play";
      renderTrace(idx, true);
    });
  });

  function syncPauseClass() {
    const activeTab = stageTabs[traceIdx];
    if (activeTab) activeTab.classList.toggle("is-paused", tracePaused || heroHoverOrFocus || !heroInView);
  }

  if (heroPlate) {
    if ("IntersectionObserver" in window) {
      new IntersectionObserver(
        (entries) => {
          heroInView = entries[0]?.isIntersecting ?? true;
          syncPauseClass();
        },
        { threshold: 0.05 }
      ).observe(heroPlate);
    }
    heroPlate.addEventListener("mouseenter", () => { heroHoverOrFocus = true; syncPauseClass(); });
    heroPlate.addEventListener("mouseleave", () => { heroHoverOrFocus = false; syncPauseClass(); });
    heroPlate.addEventListener("focusin", () => { heroHoverOrFocus = true; syncPauseClass(); });
    heroPlate.addEventListener("focusout", () => { heroHoverOrFocus = false; syncPauseClass(); });
  }

  if (traceToggle) {
    traceToggle.textContent = tracePaused ? "Play" : "Pause";
    traceToggle.addEventListener("click", () => {
      tracePaused = !tracePaused;
      traceToggle.textContent = tracePaused ? "Play" : "Pause";
      renderTrace(traceIdx, false);
      restartTraceTimer();
    });
  }
  renderTrace(0, false);
  restartTraceTimer();

  /* --------------------------------------------------------------------------
     3. Adapter Tabs, History Inspector & Interactive Tamper Proof (42501)
     -------------------------------------------------------------------------- */
  const ADAPTER_INFO = {
    prisma: { file: "@auditstream/prisma · auditstream() SQL comments plugin", raw: prismaRaw },
    drizzle: { file: "@auditstream/drizzle/pg · Drizzle 0.45 wrapper & 1.x auditComment()", raw: drizzleRaw },
    middleware: { file: "@auditstream/node/hono · HTTP boundary middleware (/express, /next too)", raw: middlewareRaw },
    node: { file: "@auditstream/node · AsyncLocalStorage.run() & audit.log(exec, event)", raw: nodeRaw },
  };
  const adapterPanels = Array.from(document.querySelectorAll("[data-adapter-panel]"));

  wireTablist(document.getElementById("adapter-tabs"), (tab) => {
    const key = tab.getAttribute("data-adapter");
    setStackActive(adapterPanels, (p) => p.getAttribute("data-adapter-panel") === key);
    const info = ADAPTER_INFO[key];
    const fname = document.getElementById("adapter-filename");
    const copyBtn = document.getElementById("copy-adapter");
    if (fname && info) fname.textContent = info.file;
    if (copyBtn && info) copyBtn.setAttribute("data-copy", info.raw);
  });

  const ROWVIEW_COPY = {
    diff: diffCopyRaw,
    cli: cliHistoryRaw,
    sql: querySqlRaw,
    jsonl: jsonlRaw,
  };
  const rowviewPanels = Array.from(document.querySelectorAll("[data-rowview-panel]"));

  wireTablist(document.getElementById("rowview-tabs"), (tab) => {
    const key = tab.getAttribute("data-rowview");
    setStackActive(rowviewPanels, (p) => p.getAttribute("data-rowview-panel") === key);
    const copyBtn = document.getElementById("copy-rowview");
    if (copyBtn && key && ROWVIEW_COPY[key]) copyBtn.setAttribute("data-copy", ROWVIEW_COPY[key]);
  });

  const tamperStrip = document.getElementById("tamper-strip");
  const tamperMsg = document.getElementById("tamper-msg");
  const tamperPill = document.getElementById("tamper-pill");
  const TAMPER_DEFAULT = "xact_id = 48291044 · role: app_user (SELECT only) · owner: auditstream_owner";
  let tamperResetTimer = 0;

  document.querySelectorAll("[data-tamper]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const op = btn.getAttribute("data-tamper") || "DELETE";
      if (!tamperStrip || !tamperMsg || !tamperPill) return;
      clearTimeout(tamperResetTimer);
      tamperStrip.classList.add("is-denied");
      tamperStrip.classList.remove("is-shaking");
      if (!prefersReducedMotion) {
        void tamperStrip.offsetWidth;
        tamperStrip.classList.add("is-shaking");
      }
      tamperMsg.textContent = `ERROR 42501: permission denied for table changes — ${op} rejected by Postgres`;
      tamperPill.textContent = "DENIED (42501)";
      tamperPill.className = "pill pill-before";
      tamperResetTimer = window.setTimeout(() => {
        tamperStrip.classList.remove("is-denied", "is-shaking");
        tamperMsg.textContent = TAMPER_DEFAULT;
        tamperPill.textContent = "TAMPER-PROOF";
        tamperPill.className = "pill pill-after";
      }, 4200);
    });
  });

  /* --------------------------------------------------------------------------
     4. Animated xid8 Safe Horizon Proof (Run #1, Run #2, Naive id > last_id + Replay)
     -------------------------------------------------------------------------- */
  const hzFootPanels = Array.from(document.querySelectorAll("[data-hz-foot]"));
  let hzReplayTimer = 0;

  function setHorizonRun(run) {
    clearTimeout(hzReplayTimer);
    document.querySelectorAll("[data-run]").forEach((b) => {
      const active = b.getAttribute("data-run") === run;
      b.setAttribute("data-active", String(active));
      b.setAttribute("aria-pressed", String(active));
    });
    setStackActive(hzFootPanels, (p) => p.getAttribute("data-hz-foot") === run);

    const lineGroup = document.getElementById("hz-line-group");
    const lineBar = document.getElementById("hz-line-bar");
    const linePill = document.getElementById("hz-line-pill");
    const lineLabel = document.getElementById("hz-line-label");
    const badge = document.getElementById("hz-badge");
    const zone = document.getElementById("hz-zone");
    const zoneLbl = document.getElementById("hz-zone-lbl");
    const bar42 = document.getElementById("bar-tx42");
    const dot42 = document.getElementById("dot-tx42");
    const txt42 = document.getElementById("txt-tx42");
    const lbl42 = document.getElementById("lbl-tx42");
    const bar43 = document.getElementById("bar-tx43");
    const dot43 = document.getElementById("dot-tx43");
    const txt43 = document.getElementById("txt-tx43");
    const bar44 = document.getElementById("bar-tx44");
    const dot44 = document.getElementById("dot-tx44");
    const txt44 = document.getElementById("txt-tx44");

    if (run === "1") {
      if (lineGroup) lineGroup.style.transform = "translateX(0px)";
      lineBar?.setAttribute("stroke", "#6ba6ff");
      linePill?.setAttribute("fill", "#4f90f5");
      if (lineLabel) { lineLabel.textContent = "xmin = 48291042"; lineLabel.setAttribute("fill", "#061221"); }
      if (badge) { badge.textContent = "xact_id < 48291042"; badge.className = "pill pill-accent"; }
      if (zone) {
        zone.style.transform = "scale(0.518, 0.254)";
        zone.setAttribute("fill", "rgba(52, 211, 153, 0.08)");
        zone.setAttribute("stroke", "rgba(52, 211, 153, 0.30)");
      }
      if (zoneLbl) { zoneLbl.setAttribute("x", "510"); zoneLbl.textContent = "SAFE EXPORT RANGE"; zoneLbl.setAttribute("fill", "#34d399"); }

      if (bar42) {
        bar42.style.transform = "scaleX(0.697)";
        bar42.setAttribute("fill", "rgba(230,179,90,0.16)");
        bar42.setAttribute("stroke", "#e6b35a");
        bar42.setAttribute("stroke-dasharray", "5 3");
      }
      if (dot42) { dot42.style.transform = "translateX(-135px)"; dot42.setAttribute("fill", "#e6b35a"); }
      txt42?.setAttribute("fill", "#e6b35a");
      if (txt42) txt42.textContent = "IN FLIGHT AT t2 — HOLDS xmin";
      lbl42?.setAttribute("fill", "var(--hold)");

      bar43?.setAttribute("fill", "rgba(107,166,255,0.15)");
      bar43?.setAttribute("stroke", "#6ba6ff");
      dot43?.setAttribute("fill", "#6ba6ff");
      if (txt43) txt43.textContent = "COMMITTED · WAITS FOR HORIZON";

      bar44?.setAttribute("fill", "rgba(107,166,255,0.15)");
      bar44?.setAttribute("stroke", "#6ba6ff");
      dot44?.setAttribute("fill", "#6ba6ff");
      if (txt44) txt44.textContent = "invoice='paid' · WAITS";
    } else if (run === "2") {
      if (lineGroup) lineGroup.style.transform = "translateX(335px)";
      lineBar?.setAttribute("stroke", "#34d399");
      linePill?.setAttribute("fill", "#34d399");
      if (lineLabel) { lineLabel.textContent = "xmin = 48291045"; lineLabel.setAttribute("fill", "#061221"); }
      if (badge) { badge.textContent = "xact_id < 48291045"; badge.className = "pill pill-after"; }
      if (zone) {
        zone.style.transform = "scale(1, 1)";
        zone.setAttribute("fill", "rgba(52, 211, 153, 0.08)");
        zone.setAttribute("stroke", "rgba(52, 211, 153, 0.30)");
      }
      if (zoneLbl) { zoneLbl.setAttribute("x", "845"); zoneLbl.textContent = "SAFE EXPORT RANGE"; zoneLbl.setAttribute("fill", "#34d399"); }

      if (bar42) {
        bar42.style.transform = "scaleX(1)";
        bar42.setAttribute("fill", "rgba(52,211,153,0.18)");
        bar42.setAttribute("stroke", "#34d399");
        bar42.removeAttribute("stroke-dasharray");
      }
      if (dot42) { dot42.style.transform = "translateX(0px)"; dot42.setAttribute("fill", "#34d399"); }
      txt42?.setAttribute("fill", "#e9f2fb");
      if (txt42) txt42.textContent = "COMMITTED AT t3 · EXPORTED IN BATCH #2 (NOT LOST!)";
      lbl42?.setAttribute("fill", "#34d399");

      bar43?.setAttribute("fill", "rgba(52,211,153,0.18)");
      bar43?.setAttribute("stroke", "#34d399");
      dot43?.setAttribute("fill", "#34d399");
      if (txt43) txt43.textContent = "EXPORTED IN BATCH #2";

      bar44?.setAttribute("fill", "rgba(52,211,153,0.18)");
      bar44?.setAttribute("stroke", "#34d399");
      dot44?.setAttribute("fill", "#34d399");
      if (txt44) txt44.textContent = "invoice='paid' · EXPORTED";
    } else {
      // Naive id > last_id bug mode: cursor jumped to id=44 at t2; tx 42 commits at t3 and is LOST FOREVER!
      if (lineGroup) lineGroup.style.transform = "translateX(0px)";
      lineBar?.setAttribute("stroke", "#f07167");
      linePill?.setAttribute("fill", "#f07167");
      if (lineLabel) { lineLabel.textContent = "last_id = 44 (BUG)"; lineLabel.setAttribute("fill", "#061221"); }
      if (badge) { badge.textContent = "id > 44 · 1 ROW LOST"; badge.className = "pill pill-before"; }
      if (zone) {
        zone.style.transform = "scale(0.518, 1)";
        zone.setAttribute("fill", "rgba(240, 113, 103, 0.08)");
        zone.setAttribute("stroke", "rgba(240, 113, 103, 0.35)");
      }
      if (zoneLbl) { zoneLbl.setAttribute("x", "510"); zoneLbl.textContent = "JUMPED PAST id 42"; zoneLbl.setAttribute("fill", "#f07167"); }

      if (bar42) {
        bar42.style.transform = "scaleX(1)";
        bar42.setAttribute("fill", "rgba(240,113,103,0.22)");
        bar42.setAttribute("stroke", "#f07167");
        bar42.removeAttribute("stroke-dasharray");
      }
      if (dot42) { dot42.style.transform = "translateX(0px)"; dot42.setAttribute("fill", "#f07167"); }
      txt42?.setAttribute("fill", "#f07167");
      if (txt42) txt42.textContent = "COMMITTED AT t3 · id 42 <= 44 · SKIPPED / LOST FOREVER!";
      lbl42?.setAttribute("fill", "#f07167");

      bar43?.setAttribute("fill", "rgba(52,211,153,0.16)");
      bar43?.setAttribute("stroke", "#34d399");
      dot43?.setAttribute("fill", "#34d399");
      if (txt43) txt43.textContent = "EXPORTED AT t2 (advances cursor)";

      bar44?.setAttribute("fill", "rgba(52,211,153,0.16)");
      bar44?.setAttribute("stroke", "#34d399");
      dot44?.setAttribute("fill", "#34d399");
      if (txt44) txt44.textContent = "EXPORTED AT t2 (last_id = 44)";
    }
  }

  document.querySelectorAll("[data-run]").forEach((b) => {
    b.addEventListener("click", () => setHorizonRun(b.getAttribute("data-run")));
  });

  document.getElementById("hz-replay")?.addEventListener("click", () => {
    setHorizonRun("1");
    hzReplayTimer = window.setTimeout(() => setHorizonRun("2"), prefersReducedMotion ? 400 : 1200);
  });

  /* Curtain footer keyboard accessibility: scroll bottom into view when Tab enters sticky footer */
  document.querySelector(".footer")?.addEventListener("focusin", () => {
    const main = document.querySelector(".main");
    if (main && main.getBoundingClientRect().bottom > window.innerHeight - 8) {
      window.scrollTo({ top: document.documentElement.scrollHeight, behavior: prefersReducedMotion ? "auto" : "smooth" });
    }
  });
</script>
