---
import BaseLayout from "../layouts/BaseLayout.astro";
import BrandMark from "../components/BrandMark.astro";
import { highlightCode } from "../lib/highlight";
import "../styles/landing.css";

// All code snippets pre-rendered at build time via Shiki dual themes (0 KB highlighter JS!)
// Every line formatted <= 54 columns so zero horizontal overflow occurs at 1024px–1920px!

const trace0Html = await highlightCode(
  `UPDATE invoice\nSET status = $1\nWHERE id = $2\n/*auditstream='eyJ0eXBlIjoidXNlciIsImlkIjoidXNyXzQyIn0'*/`,
  "sql",
  { lineNumbers: true, highlightAuditComment: true }
);

const trace1Html = await highlightCode(
  `-- Row-level UPDATE trigger (WHEN OLD.* IS DISTINCT FROM NEW.*)\n-- actor_source = 'comment' (unpadded base64url, IDs only)\nactor   : { "type": "user", "id": "usr_42" }\nchanged : [ "status" ]  -- "open" -> "paid"`,
  "sql",
  { lineNumbers: true }
);

const trace2Html = await highlightCode(
  `INSERT INTO auditstream.changes\n  (xact_id, source, table_name, op, changed, actor)\nVALUES (\n  pg_current_xact_id(), 'db', 'invoice', 'UPDATE',\n  ARRAY['status'], '{"type":"user","id":"usr_42"}'\n);`,
  "sql",
  { lineNumbers: true }
);

const trace3Html = await highlightCode(
  `auditstream export --format jsonl \\\n  --output changes.jsonl --cursor-file cursor.json\n# window: xact_id >= cursor AND xact_id < xmin\n# exported 1,428 rows (JSONL) · ack after flush`,
  "bash",
  { lineNumbers: true }
);

const prismaRaw = `import { PrismaClient } from "@prisma/client";
import { audit } from "@auditstream/node";
import { auditstream } from "@auditstream/prisma";

const db = new PrismaClient({
  comments: [auditstream()],
});

await audit.as(
  {
    type: "ai_agent",
    id: "billing-agent",
    onBehalfOf: { type: "user", id: "usr_42" },
    tenant: "org_acme",
  },
  async () => {
    await db.invoice.update({
      where: { id: "inv_901" },
      data: { status: "paid" },
    });
  }
);`;

const prismaHtml = await highlightCode(prismaRaw, "ts", { lineNumbers: true });

const drizzleRaw = `import { drizzle } from "drizzle-orm/node-postgres";
import { eq } from "drizzle-orm";
import { audit } from "@auditstream/node";
import { wrapPgPool } from "@auditstream/drizzle/pg";
import { invoice } from "./schema";

// Drizzle 0.45 wrapper (or auditComment() in 1.x)
const db = drizzle({ client: wrapPgPool(pool) });

await audit.as(
  { type: "user", id: "usr_42", tenant: "org_acme" },
  async () => {
    await db.update(invoice)
      .set({ status: "paid" })
      .where(eq(invoice.id, "inv_901"));
  }
);`;

const drizzleHtml = await highlightCode(drizzleRaw, "ts", { lineNumbers: true });

const nodeRaw = `import { audit } from "@auditstream/node";

// AsyncLocalStorage.run() — works in Node, Bun, Deno,
// and Cloudflare Workers (nodejs_als)
const exec = (sql, vals) => pool.query(sql, vals);

await audit.as(
  { type: "api_key", id: "key_prod_09" },
  async () => {
    // DB writes are captured by PG triggers.
    // App-only events go via auditstream.log_event:
    await audit.log(exec, {
      action: "invoice.exported",
      target: { table: "invoice", id: "inv_901" },
      data: { format: "jsonl" },
    });
  }
);`;

const nodeHtml = await highlightCode(nodeRaw, "ts", { lineNumbers: true });

const querySqlHtml = await highlightCode(
  `-- App role has SELECT only (INSERT/UPDATE/DELETE denied)\nSELECT xact_id, occurred_at, actor, changed,\n       before->>'status' AS prev,\n       after->>'status'  AS next\nFROM   auditstream.changes\nWHERE  table_name = 'invoice'\n  AND  record_id  = '{"id":"inv_901"}'::jsonb\nORDER BY xact_id DESC, id DESC;`,
  "sql",
  { lineNumbers: true }
);

const jsonlHtml = await highlightCode(
  `{\n  "schema_version": 1,\n  "event_id": "019ab7c1-442e-7a10-9c2a-81f02b9c1140",\n  "occurred_at": "2026-11-24T04:11:09.184000Z",\n  "source": "db", "op": "UPDATE",\n  "schema_name": "public", "table_name": "invoice",\n  "record_id": { "id": "inv_901" },\n  "actor_source": "comment", "db_user": "app_user",\n  "actor": {\n    "type": "ai_agent", "id": "billing-agent",\n    "onBehalfOf": { "type": "user", "id": "usr_42" }\n  },\n  "changed": ["status"],\n  "before": { "status": "open" },\n  "after":  { "status": "paid" }\n}`,
  "json",
  { lineNumbers: true }
);

const qs1Cmd = "auditstream init --migrations prisma --table public.invoice --table public.users";
const qs1Html = await highlightCode(
  `auditstream init --migrations prisma \\\n  --table public.invoice --table public.users\n# wrote partitioned auditstream.changes + triggers\n# partial HASH lookup index · hybrid triggers`,
  "bash",
  { lineNumbers: true }
);

const qs2Cmd = "pnpm add @auditstream/node @auditstream/prisma";
const qs2Html = await highlightCode(qs2Cmd, "bash", { lineNumbers: true });

const qs3Cmd = "auditstream history --table public.invoice --limit 10 && auditstream export --format jsonl --output audit.jsonl --cursor-file cursor.json";
const qs3Html = await highlightCode(
  `auditstream history --table public.invoice --limit 10\nauditstream export --format jsonl \\\n  --output audit.jsonl --cursor-file cursor.json\n# xid8 window exported · acked after sink flush`,
  "bash",
  { lineNumbers: true }
);
---

<BaseLayout
  title="Auditstream — Open-source audit trail engine for PostgreSQL"
  description="Open-source audit trail engine written in Rust. Records who changed what in PostgreSQL 15–19 with before and after values, an append-only history table, and lossless xid8 export."
  currentPath="/"
  showProgress={true}
>
  <main class="main">
    <!-- ======================================================================
         HERO — Pixel-flush Dual-Line Lockup + Live Telemetry Instrument
         ====================================================================== -->
    <section class="section hero">
      <div class="shell">
        <div class="hero-top-row">
          <div class="eyebrow">
            <span class="eyebrow-dot" />
            <span>FORENSIC LEDGER · POSTGRESQL 15–19 · RUST</span>
          </div>
          <div class="mono" style="font-size:0.7rem;color:var(--ink-3);">
            ZERO DAEMON · ZERO WAL SLOTS · ZERO NEW INFRA
          </div>
        </div>

        <div class="hero-fit-box" id="hero-fit-box">
          <h1 class="hero-h1">
            <span class="mask-line">
              <span class="fit-line" style="--fit:114.6%;--wdth:114.6;">Every row changed<span class="dot-accent">.</span></span>
            </span>
            <span class="mask-line">
              <span class="fit-line" style="--fit:122.1%;--wdth:122.1;">Proven in Postgres<span class="dot-accent">.</span></span>
            </span>
          </h1>
        </div>

        <div class="hero-grid">
          <div>
            <p class="lead">
              Auditstream is an open-source audit trail engine in Rust. Adapters attach the actor as a
              trailing <code class="ic">sqlcommenter</code> tag, generated triggers record
              <code class="ic">before</code> and <code class="ic">after</code> in
              <code class="ic">auditstream.changes</code>, and the CLI exports on demand with a lossless
              <code class="ic">xid8</code> cursor.
            </p>

            <div style="margin-top:1.65rem;display:flex;flex-wrap:wrap;gap:0.7rem;">
              <a href="#quickstart" class="btn btn-primary">Install auditstream</a>
              <a href="/docs" class="btn btn-secondary">Read the docs</a>
            </div>

            <div class="hero-specs">
              <div>
                <div class="spec-k">Postgres</div>
                <div class="spec-v">15 – 19</div>
              </div>
              <div>
                <div class="spec-k">24/7 Daemon</div>
                <div class="spec-v">None (0)</div>
              </div>
              <div>
                <div class="spec-k">TypeScript ESM</div>
                <div class="spec-v">Prisma 7 · Drizzle · Node</div>
              </div>
            </div>
          </div>

          <!-- LIVE TELEMETRY INSTRUMENT (Pre-rendered Shiki HTML!) -->
          <div class="plate plate-reg" aria-label="Audit trail capture lifecycle">
            <div class="plate-bar">
              <span id="trace-title">01 · Trailing sqlcommenter tag (base64url)</span>
              <div style="display:flex;align-items:center;gap:0.5rem;">
                <span class="pill pill-accent" id="trace-badge">NO EXPLICIT TX</span>
                <button type="button" class="chip-btn" id="trace-toggle" style="height:1.55rem;padding:0 0.5rem;">
                  Pause
                </button>
              </div>
            </div>

            <div class="telemetry-diagram">
              <svg class="telemetry-svg" viewBox="0 0 680 54" fill="none" aria-hidden="true">
                <line x1="56" y1="20" x2="624" y2="20" stroke="var(--rule-strong)" stroke-width="1" />
                <line
                  id="rail-active"
                  x1="56"
                  y1="20"
                  x2="56"
                  y2="20"
                  stroke="var(--accent)"
                  stroke-width="2"
                  style="transition:all 420ms var(--ease-out);"
                />
                <g class="t-node" data-idx="0">
                  <rect x="44" y="8" width="24" height="24" fill="var(--plate)" stroke="var(--accent)" stroke-width="1.5" />
                  <circle cx="56" cy="20" r="3.5" fill="var(--accent)" />
                  <text x="56" y="47" text-anchor="middle" fill="var(--ink)" font-family="IBM Plex Mono, monospace" font-size="9.5">APP / SQL</text>
                </g>
                <g class="t-node" data-idx="1">
                  <rect x="233" y="8" width="24" height="24" fill="var(--plate)" stroke="var(--rule-strong)" stroke-width="1.5" />
                  <circle cx="245" cy="20" r="3.5" fill="var(--ink-3)" />
                  <text x="245" y="47" text-anchor="middle" fill="var(--ink-3)" font-family="IBM Plex Mono, monospace" font-size="9.5">PG TRIGGER</text>
                </g>
                <g class="t-node" data-idx="2">
                  <rect x="422" y="8" width="24" height="24" fill="var(--plate)" stroke="var(--rule-strong)" stroke-width="1.5" />
                  <circle cx="434" cy="20" r="3.5" fill="var(--ink-3)" />
                  <text x="434" y="47" text-anchor="middle" fill="var(--ink-3)" font-family="IBM Plex Mono, monospace" font-size="9.5">CHANGES (xid8)</text>
                </g>
                <g class="t-node" data-idx="3">
                  <rect x="612" y="8" width="24" height="24" fill="var(--plate)" stroke="var(--rule-strong)" stroke-width="1.5" />
                  <circle cx="624" cy="20" r="3.5" fill="var(--ink-3)" />
                  <text x="624" y="47" text-anchor="middle" fill="var(--ink-3)" font-family="IBM Plex Mono, monospace" font-size="9.5">JSONL / CSV</text>
                </g>
              </svg>
            </div>

            <div class="stage-tabs" id="stage-tabs">
              <button type="button" class="stage-tab" data-step="0" data-active="true"><span class="num">01</span>SQL Comment</button>
              <button type="button" class="stage-tab" data-step="1" data-active="false"><span class="num">02</span>Trigger Diff</button>
              <button type="button" class="stage-tab" data-step="2" data-active="false"><span class="num">03</span>Changes Table</button>
              <button type="button" class="stage-tab" data-step="3" data-active="false"><span class="num">04</span>xid8 Export</button>
            </div>

            <div class="telemetry-body">
              <div class="telemetry-panel" data-panel="0" set:html={trace0Html} />
              <div class="telemetry-panel" data-panel="1" hidden set:html={trace1Html} />
              <div class="telemetry-panel" data-panel="2" hidden set:html={trace2Html} />
              <div class="telemetry-panel" data-panel="3" hidden set:html={trace3Html} />
              <div style="font-size:0.79rem;color:var(--ink-2);line-height:1.5;" id="trace-caption">
                Unpadded base64url can never contain <code class="ic">*/</code> or inject SQL. IDs only — no names, emails, or IPs leak into <code class="ic">pg_stat_activity</code>.
              </div>
            </div>

            <div class="ledger-strip">
              <span>xact_id <strong style="color:var(--ink);">48291044</strong> · public.invoice · UPDATE</span>
              <span style="display:inline-flex;gap:0.4rem;">
                <span class="pill pill-before">− open</span>
                <span class="pill pill-after">+ paid</span>
              </span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ======================================================================
         SECTION 01 — ATTRIBUTION & AI AGENT ACTORS (auditstream-js)
         ====================================================================== -->
    <section class="section section-alt" id="attribution">
      <div class="shell split">
        <div class="reveal">
          <div class="eyebrow"><span class="eyebrow-dot" />01 · ATTRIBUTION &amp; CONTRACT</div>
          <h2 class="h2" style="margin-top:0.85rem;">Author in a trailing comment, not a pinned session.</h2>
          <p class="lead" style="margin-top:1.1rem;">
            Application code never writes audit rows itself. <code class="ic">audit.as()</code> awaits your
            writes inside <code class="ic">AsyncLocalStorage.run()</code> and appends an unpadded base64url
            <code class="ic">sqlcommenter</code> tag — supporting humans, API keys, services, and
            <strong style="color:var(--ink);font-weight:600;">AI agents acting <code class="ic">onBehalfOf</code> a user</strong>.
          </p>
          <p class="lead" style="margin-top:0.85rem;">
            Because comments stay on the statement, standalone Prisma 7 queries need no explicit transaction
            and never pin connections on RDS Proxy. Malformed payloads never abort your write.
          </p>

          <div class="callout-pair">
            <div class="callout-cell">
              <div class="spec-k">Trailing comment (default)</div>
              <div class="spec-v" style="color:var(--after);white-space:normal;">10.4 ns cached tag · Pool-safe</div>
            </div>
            <div class="callout-cell">
              <div class="spec-k">set_config (fallback)</div>
              <div class="spec-v" style="color:var(--ink-2);white-space:normal;">9.3 ns cached JSON · Explicit tx</div>
            </div>
          </div>

          <div class="resolution-strip">
            <span style="color:var(--ink-3);">ACTOR PRECEDENCE:</span>
            <span style="color:var(--accent);">1. set_config</span> →
            <span style="color:var(--accent);">2. /*auditstream='…'*/</span> →
            <span>3. request.jwt.claims (Supabase)</span> →
            <span>4. session_user</span>
          </div>
        </div>

        <div class="plate plate-reg reveal">
          <div class="plate-bar" style="padding:0 0.75rem 0 0;">
            <div class="tabs" role="tablist" aria-label="TypeScript adapter examples">
              <button type="button" class="tab" role="tab" data-adapter="prisma" aria-selected="true">Prisma 7</button>
              <button type="button" class="tab" role="tab" data-adapter="drizzle" aria-selected="false">Drizzle</button>
              <button type="button" class="tab" role="tab" data-adapter="node" aria-selected="false">Node / App events</button>
            </div>
            <button type="button" class="chip-btn" id="copy-adapter" data-copy={prismaRaw} style="height:1.65rem;">Copy</button>
          </div>
          <div class="tab-panel" data-adapter-panel="prisma" set:html={prismaHtml} />
          <div class="tab-panel" data-adapter-panel="drizzle" hidden set:html={drizzleHtml} />
          <div class="tab-panel" data-adapter-panel="node" hidden set:html={nodeHtml} />
          <div class="plate-bar" style="border-top:1px solid var(--rule);border-bottom:0;">
            <span id="adapter-filename">@auditstream/prisma · auditstream() SQL comments plugin</span>
            <span class="pill pill-accent">ESM only · spec 0.1</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ======================================================================
         SECTION 02 — PARTITIONED APPEND-ONLY HISTORY TABLE
         ====================================================================== -->
    <section class="section" id="history">
      <div class="shell split">
        <div class="reveal">
          <div class="eyebrow"><span class="eyebrow-dot" />02 · AUDITSTREAM.CHANGES</div>
          <h2 class="h2" style="margin-top:0.85rem;">The history table <em>is</em> the product.</h2>
          <p class="lead" style="margin-top:1.1rem;">
            <code class="ic">auditstream.changes</code> is partitioned by month on <code class="ic">occurred_at</code>,
            owned by a dedicated <code class="ic">NOLOGIN</code> role, and written exclusively through
            <code class="ic">SECURITY DEFINER</code> triggers. Your application role receives
            <code class="ic">SELECT</code> only — its <code class="ic">INSERT</code>, <code class="ic">UPDATE</code>,
            and <code class="ic">DELETE</code> tamper attempts are rejected by Postgres itself.
          </p>
          <p class="lead" style="margin-top:0.85rem;">
            INSERT and DELETE fire once per statement via transition tables (<code class="ic">REFERENCING NEW/OLD TABLE</code>);
            UPDATE stays row-level with <code class="ic">WHEN (OLD.* IS DISTINCT FROM NEW.*)</code> so no-op and
            excluded-column writes record nothing. Lookups use a partial <code class="ic">HASH</code> index on
            <code class="ic">record_id</code> alongside a monthly BRIN on <code class="ic">occurred_at</code>.
          </p>
        </div>

        <div class="plate plate-reg reveal">
          <div class="plate-bar" style="padding:0 0.9rem 0 0;">
            <div class="tabs" role="tablist" aria-label="Inspect committed audit row">
              <button type="button" class="tab" role="tab" data-rowview="diff" aria-selected="true">Diff view</button>
              <button type="button" class="tab" role="tab" data-rowview="sql" aria-selected="false">Query SQL</button>
              <button type="button" class="tab" role="tab" data-rowview="jsonl" aria-selected="false">Export JSONL</button>
            </div>
            <span style="color:var(--accent);padding:0.35rem 0 0.35rem 0.9rem;">xact_id = 48291044</span>
          </div>

          <div class="tab-panel" data-rowview-panel="diff">
            <div class="diff-split">
              <div class="diff-pane">
                <div class="diff-head"><span style="color:var(--before);">− BEFORE (OLD)</span><span style="color:var(--ink-3);">jsonb</span></div>
                <div class="diff-line">&#123;</div>
                <div class="diff-line">  "id": "inv_901",</div>
                <div class="diff-line">  "amount_cents": 4900,</div>
                <div class="diff-line del">− "status": "open",</div>
                <div class="diff-line del">− "paid_at": null</div>
                <div class="diff-line">&#125;</div>
              </div>
              <div class="diff-pane">
                <div class="diff-head"><span style="color:var(--after);">+ AFTER (NEW)</span><span style="color:var(--ink-3);">jsonb</span></div>
                <div class="diff-line">&#123;</div>
                <div class="diff-line">  "id": "inv_901",</div>
                <div class="diff-line">  "amount_cents": 4900,</div>
                <div class="diff-line add">+ "status": "paid",</div>
                <div class="diff-line add">+ "paid_at": "2026-11-24T04:11Z"</div>
                <div class="diff-line">&#125;</div>
              </div>
            </div>
          </div>

          <div class="tab-panel" data-rowview-panel="sql" hidden set:html={querySqlHtml} />
          <div class="tab-panel" data-rowview-panel="jsonl" hidden set:html={jsonlHtml} />

          <div class="plate-bar" style="border-top:1px solid var(--rule);border-bottom:0;">
            <span>actor: <strong style="color:var(--accent);">ai_agent:billing-agent</strong> (onBehalfOf <strong style="color:var(--ink);">usr_42</strong>)</span>
            <span>SELECT-ONLY FOR APP ROLE</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ======================================================================
         SECTION 03 — SIGNATURE VISUAL: INTERACTIVE xid8 SAFE-HORIZON PROOF
         ====================================================================== -->
    <section class="field-band" id="export">
      <div class="shell">
        <div class="eyebrow"><span class="eyebrow-dot" />03 · LOSSLESS EXPORT · xid8 WINDOW</div>
        <h2 class="h2" style="margin-top:0.85rem;max-width:21ch;">Export anywhere, without a 24/7 consumer.</h2>
        <p class="lead" style="margin-top:1.1rem;max-width:46rem;">
          Logical replication needs an always-on consumer — a stopped slot retains WAL and can fill your disk.
          Auditstream exports pull-based batches on demand using
          <code class="ic" style="background:var(--field-2);border-color:var(--on-field-rule-strong);color:var(--on-field);">xact_id &gt;= cursor AND xact_id &lt; pg_snapshot_xmin()</code>,
          acknowledging the cursor only after the sink flushes.
        </p>

        <div class="horizon-board reveal">
          <div class="horizon-bar">
            <div style="display:flex;align-items:center;gap:0.75rem;flex-wrap:wrap;">
              <span style="color:var(--on-field);font-weight:600;">CONCURRENT COMMITS vs. SAFE HORIZON</span>
              <span class="pill pill-accent" id="hz-badge">HORIZON: xact_id &lt; 48291042</span>
            </div>
            <div class="horizon-toggle" role="group" aria-label="Simulate export runs">
              <button type="button" class="horizon-btn" data-run="1" data-active="true">Run #1 · tx 42 still open</button>
              <button type="button" class="horizon-btn" data-run="2" data-active="false">Run #2 · tx 42 commits</button>
            </div>
          </div>

          <div class="horizon-canvas">
            <svg class="horizon-svg" viewBox="0 0 960 284" fill="none" role="img" aria-label="Diagram showing xid8 safe horizon cursor across 5 concurrent PostgreSQL transactions">
              <g stroke="var(--on-field-rule)" stroke-dasharray="3 4">
                <line x1="160" y1="32" x2="160" y2="244" />
                <line x1="340" y1="32" x2="340" y2="244" />
                <line x1="520" y1="32" x2="520" y2="244" />
                <line x1="690" y1="32" x2="690" y2="244" />
                <line x1="855" y1="32" x2="855" y2="244" />
              </g>
              <g fill="var(--on-field-3)" font-family="IBM Plex Mono, monospace" font-size="10">
                <text x="160" y="20" text-anchor="middle">t0</text>
                <text x="340" y="20" text-anchor="middle">t1</text>
                <text x="520" y="20" text-anchor="middle">t2 (Export #1)</text>
                <text x="690" y="20" text-anchor="middle">t3</text>
                <text x="855" y="20" text-anchor="middle">t4 (Export #2)</text>
              </g>

              <rect id="hz-zone" x="160" y="34" width="360" height="44" fill="rgba(52, 211, 153, 0.08)" stroke="rgba(52, 211, 153, 0.30)" style="transition:all 420ms var(--ease-out);" />
              <text id="hz-zone-lbl" x="510" y="45" text-anchor="end" fill="#34d399" font-family="IBM Plex Mono, monospace" font-size="8.5" letter-spacing="0.08em" opacity="0.85">SAFE EXPORT RANGE</text>

              <g font-family="IBM Plex Mono, monospace" font-size="11.5" fill="var(--on-field)">
                <text x="12" y="61">xid 48291041</text>
                <text x="12" y="104" fill="var(--hold)" id="lbl-tx42">xid 48291042</text>
                <text x="12" y="147">xid 48291043</text>
                <text x="12" y="190" fill="var(--accent)">xid 48291044</text>
                <text x="12" y="233" fill="var(--on-field-3)">xid 48291045</text>
              </g>

              <g stroke="var(--on-field-rule)" stroke-width="1">
                <line x1="12" y1="78" x2="942" y2="78" />
                <line x1="12" y1="121" x2="942" y2="121" />
                <line x1="12" y1="164" x2="942" y2="164" />
                <line x1="12" y1="207" x2="942" y2="207" />
              </g>

