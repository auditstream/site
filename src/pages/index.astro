---
import BaseLayout from "../layouts/BaseLayout.astro";
import BrandMark from "../components/BrandMark.astro";
import LiveWorkbench from "../components/LiveWorkbench.astro";
import { highlightCode } from "../lib/highlight";
import "../styles/landing.css";

// All code snippets pre-rendered at build time via Shiki dual themes (0 KB highlighter JS!)
// Every line formatted <= 54 columns so zero horizontal overflow occurs at 1024px–1920px!

const trace0Html = await highlightCode(
  `UPDATE invoice\nSET status = $1\nWHERE id = $2\n/*auditstream='eyJ0eXBlIjoidXNlciIsImlkIjoidXNyXzQyIn0'*/`,
  "sql",
  { lineNumbers: true, highlightAuditComment: true }
);

const trace1Html = await highlightCode(
  `-- Row-level UPDATE (OLD.* IS DISTINCT FROM NEW.*)\n-- actor_source = 'comment' (base64url, IDs only)\nactor   : { "type": "user", "id": "usr_42" }\nchanged : [ "status" ]  -- "open" -> "paid"`,
  "sql",
  { lineNumbers: true }
);

const trace2Html = await highlightCode(
  `INSERT INTO auditstream.changes\n  (xact_id, source, table_name, op, changed, actor)\nVALUES (\n  pg_current_xact_id(), 'db', 'invoice', 'UPDATE',\n  ARRAY['status'], '{"type":"user","id":"usr_42"}'\n);`,
  "sql",
  { lineNumbers: true }
);

const trace3Html = await highlightCode(
  `auditstream export --format jsonl \\\n  --output changes.jsonl --cursor-file cursor.json\n# window: xact_id >= cursor AND xact_id < xmin\n# exported 1,428 rows (JSONL) · ack after flush`,
  "bash",
  { lineNumbers: true }
);

const prismaRaw = `import { PrismaClient } from "@prisma/client";
import { audit } from "@auditstream/node";
import { auditstream } from "@auditstream/prisma";

const db = new PrismaClient({
  comments: [auditstream()],
});

await audit.as(
  {
    type: "ai_agent",
    id: "billing-agent",
    onBehalfOf: { type: "user", id: "usr_42" },
    tenant: "org_acme",
  },
  async () => {
    await db.invoice.update({
      where: { id: "inv_901" },
      data: { status: "paid" },
    });
  }
);`;

const prismaHtml = await highlightCode(prismaRaw, "ts", { lineNumbers: true });

const drizzleRaw = `import { drizzle } from "drizzle-orm/node-postgres";
import { eq } from "drizzle-orm";
import { audit } from "@auditstream/node";
import { wrapPgPool } from "@auditstream/drizzle/pg";
import { invoice } from "./schema";

// Drizzle 0.45 wrapper (or auditComment() in 1.x)
const db = drizzle({ client: wrapPgPool(pool) });

await audit.as(
  { type: "user", id: "usr_42", tenant: "org_acme" },
  async () => {
    await db.update(invoice)
      .set({ status: "paid" })
      .where(eq(invoice.id, "inv_901"));
  }
);`;

const drizzleHtml = await highlightCode(drizzleRaw, "ts", { lineNumbers: true });

const middlewareRaw = `import { Hono } from "hono";
import { auditstream } from "@auditstream/node/hono";

const app = new Hono();

// Wire once per request (also /express, /next)
app.use(
  "*",
  auditstream({
    actor: (c) => {
      const id = c.get("authUserId");
      return id ? { type: "user", id } : undefined;
    },
    context: (c) => ({
      requestId: c.req.header("x-request-id"),
      source: "api",
    }),
  })
);`;

const middlewareHtml = await highlightCode(middlewareRaw, "ts", { lineNumbers: true });

const nodeRaw = `import { audit } from "@auditstream/node";

// AsyncLocalStorage.run() — works in Node, Bun, Deno,
// and Cloudflare Workers (nodejs_als)
const exec = (sql, vals) => pool.query(sql, vals);

await audit.as(
  { type: "api_key", id: "key_prod_09" },
  async () => {
    // DB writes are captured by PG triggers.
    // App-only events go via auditstream.log_event:
    await audit.log(exec, {
      action: "invoice.exported",
      target: { table: "invoice", id: "inv_901" },
      data: { format: "jsonl" },
    });
  }
);`;

const nodeHtml = await highlightCode(nodeRaw, "ts", { lineNumbers: true });

const diffCopyRaw = JSON.stringify(
  {
    table: "public.invoice",
    record_id: { id: "inv_901" },
    changed: ["status", "paid_at"],
    before: { status: "open", paid_at: null },
    after: { status: "paid", paid_at: "2026-11-24T04:11:09.184000Z" },
  },
  null,
  2
);

const cliHistoryRaw = `auditstream history --table public.invoice --limit 2`;
const cliHistoryHtml = await highlightCode(
  `${cliHistoryRaw}\n# OCCURRED_AT          OP      RECORD  ACTOR\n# 2026-11-24T04:11:09Z UPDATE  inv_901 billing-agent\n#   for user:usr_42 · comment · status,paid_at\n# 2026-11-24T04:08:12Z INSERT  inv_901 user:usr_42\n#   comment · -`,
  "bash",
  { lineNumbers: true }
);

const querySqlRaw = `-- App role has SELECT only (INSERT/UPDATE/DELETE denied)\nSELECT xact_id, occurred_at, actor, changed,\n       before->>'status' AS prev,\n       after->>'status'  AS next\nFROM   auditstream.changes\nWHERE  table_name = 'invoice'\n  AND  record_id  = '{"id":"inv_901"}'::jsonb\nORDER BY xact_id DESC, id DESC;`;

const querySqlHtml = await highlightCode(querySqlRaw, "sql", { lineNumbers: true });

const jsonlRaw = `{\n  "schema_version": 1,\n  "event_id": "019ab7c1-442e-7a10-9c2a-81f02b9c1140",\n  "occurred_at": "2026-11-24T04:11:09.184000Z",\n  "source": "db", "op": "UPDATE",\n  "schema_name": "public", "table_name": "invoice",\n  "record_id": { "id": "inv_901" },\n  "actor_source": "comment", "db_user": "app_user",\n  "actor": {\n    "type": "ai_agent", "id": "billing-agent",\n    "onBehalfOf": { "type": "user", "id": "usr_42" }\n  },\n  "changed": ["status", "paid_at"],\n  "before": { "status": "open", "paid_at": null },\n  "after": {\n    "status": "paid",\n    "paid_at": "2026-11-24T04:11:09.184000Z"\n  }\n}`;

const jsonlHtml = await highlightCode(jsonlRaw, "json", { lineNumbers: true });

const verifyCmd = "auditstream verify --format json";
const verifyHtml = await highlightCode(
  `${verifyCmd}\n# [ok]    public.invoice  4 triggers intact\n# [error] public.users    disabled (tgenabled = 'D')\n# [warn]  partitions      <2 future months (--fix)\n# exit 3 -> blocks CI before an audit gap ships`,
  "bash",
  { lineNumbers: true }
);

const qs0Cmd = "curl --proto '=https' --tlsv1.2 -LsSf https://github.com/auditstream/auditstream/releases/latest/download/auditstream-installer.sh | sh";
const qs0Html = await highlightCode(
  `# macOS / Linux shell installer\ncurl --proto '=https' --tlsv1.2 -LsSf https://github.com/auditstream/auditstream/releases/latest/download/auditstream-installer.sh | sh\n# Or: brew install auditstream/tap/auditstream · npm i -g auditstream · ghcr.io/auditstream/auditstream`,
  "bash",
  { lineNumbers: true }
);

const qs1Cmd = "auditstream init --migrations prisma --table public.invoice --table public.users --exclude public.users.password_hash";
const qs1Html = await highlightCode(
  `auditstream init --migrations prisma \\\n  --table public.invoice --table public.users \\\n  --exclude public.users.password_hash\n# partitioned auditstream.changes + partial HASH idx`,
  "bash",
  { lineNumbers: true }
);

const qs2Cmd = "pnpm add @auditstream/node @auditstream/prisma";
const qs2Html = await highlightCode(qs2Cmd, "bash", { lineNumbers: true });

const qs3Cmd = "auditstream history --table public.invoice --limit 10 && auditstream export --format jsonl --output audit.jsonl --cursor-file cursor.json";
const qs3Html = await highlightCode(
  `auditstream history --table public.invoice --limit 10\nauditstream export --format jsonl \\\n  --output audit.jsonl --cursor-file cursor.json\n# xid8 window exported · acked after sink flush`,
  "bash",
  { lineNumbers: true }
);
---

<BaseLayout
  title="Auditstream — Open-source audit trail engine for PostgreSQL"
  description="Open-source audit trail engine written in Rust. Records who changed what in PostgreSQL 15–19 with before and after values, an append-only history table, and lossless xid8 export."
  currentPath="/"
  showProgress={true}
>
  <main class="main">
    <!-- ======================================================================
         HERO — Pixel-flush Dual-Line Lockup + Live Telemetry Instrument
         ====================================================================== -->
    <section class="section hero">
      <div class="shell">
        <div class="hero-top-row">
          <div class="eyebrow">
            <span class="eyebrow-dot" />
            <span>FORENSIC LEDGER · POSTGRESQL 15–19 · RUST · ZERO DAEMON</span>
          </div>
        </div>

        <div class="hero-fit-box" id="hero-fit-box">
          <h1 class="hero-h1">
            <span class="mask-line">
              <span class="fit-line">Every row changed<span class="dot-accent">.</span></span>
            </span>
            <span class="mask-line">
              <span class="fit-line">Proven in Postgres<span class="dot-accent">.</span></span>
            </span>
          </h1>
        </div>

        <div class="hero-grid">
          <div>
            <p class="lead">
              Auditstream is an open-source audit trail engine in Rust. Adapters attach the actor as a
              trailing <code class="ic">sqlcommenter</code> tag, generated triggers record
              <code class="ic">before</code> and <code class="ic">after</code> in
              <code class="ic">auditstream.changes</code>, and the CLI exports on demand with a lossless
              <code class="ic">xid8</code> cursor.
            </p>

            <div style="margin-top:1.65rem;display:flex;flex-wrap:wrap;gap:0.7rem;">
              <a href="#quickstart" class="btn btn-primary">Install auditstream</a>
              <a href="#workbench" class="btn btn-secondary">Try live simulator</a>
            </div>

            <div class="hero-specs">
              <div>
                <div class="spec-k">Postgres</div>
                <div class="spec-v">15 – 19</div>
              </div>
              <div>
                <div class="spec-k">24/7 Daemon</div>
                <div class="spec-v">None (0)</div>
              </div>
              <div>
                <div class="spec-k">TypeScript ESM</div>
                <div class="spec-v">Prisma 7 · Drizzle · Node</div>
              </div>
            </div>
          </div>

          <!-- LIVE TELEMETRY INSTRUMENT (Pre-rendered Shiki HTML, Zero-CLS .panel-stack!) -->
          <div class="plate plate-reg" id="hero-telemetry" aria-label="Audit trail capture lifecycle">
            <div class="plate-bar telemetry-head">
              <span id="trace-title">01 · Trailing sqlcommenter tag (base64url)</span>
              <div style="display:flex;align-items:center;gap:0.5rem;flex-shrink:0;">
                <span class="pill pill-accent" id="trace-badge">NO EXPLICIT TX</span>
                <button type="button" class="chip-btn" id="trace-toggle" style="height:1.55rem;min-width:3.9rem;padding:0 0.5rem;">
                  Pause
                </button>
              </div>
            </div>

            <div class="hero-stepper-rail">
              <svg class="telemetry-svg" viewBox="0 0 680 26" fill="none" aria-hidden="true">
                <line x1="85" y1="13" x2="595" y2="13" stroke="var(--rule-strong)" stroke-width="1" />
                <line
                  id="rail-active"
                  x1="85"
                  y1="13"
                  x2="595"
                  y2="13"
                  stroke="var(--accent)"
                  stroke-width="2"
                  stroke-dasharray="510"
                  stroke-dashoffset="510"
                />
                <line
                  id="rail-packet"
                  x1="85"
                  y1="13"
                  x2="595"
                  y2="13"
                  stroke="var(--after)"
                  stroke-width="3"
                  stroke-dasharray="28 540"
                  stroke-dashoffset="28"
                />
                <g class="t-node t-node-btn" data-idx="0">
                  <rect x="76" y="4" width="18" height="18" fill="var(--plate)" stroke="var(--accent)" stroke-width="1.5" />
                  <circle cx="85" cy="13" r="3" fill="var(--accent)" />
                </g>
                <g class="t-node t-node-btn" data-idx="1">
                  <rect x="246" y="4" width="18" height="18" fill="var(--plate)" stroke="var(--rule-strong)" stroke-width="1.5" />
                  <circle cx="255" cy="13" r="3" fill="var(--ink-3)" />
                </g>
                <g class="t-node t-node-btn" data-idx="2">
                  <rect x="416" y="4" width="18" height="18" fill="var(--plate)" stroke="var(--rule-strong)" stroke-width="1.5" />
                  <circle cx="425" cy="13" r="3" fill="var(--ink-3)" />
                </g>
                <g class="t-node t-node-btn" data-idx="3">
                  <rect x="586" y="4" width="18" height="18" fill="var(--plate)" stroke="var(--rule-strong)" stroke-width="1.5" />
                  <circle cx="595" cy="13" r="3" fill="var(--ink-3)" />
                </g>
              </svg>
            </div>

            <div class="stage-tabs" id="stage-tabs" role="tablist" aria-label="Capture pipeline stages">
              <button type="button" class="stage-tab" role="tab" id="stage-tab-0" aria-controls="stage-panel-0" aria-selected="true" data-step="0" data-active="true"><span class="num">01</span>SQL Comment</button>
              <button type="button" class="stage-tab" role="tab" id="stage-tab-1" aria-controls="stage-panel-1" aria-selected="false" tabindex="-1" data-step="1" data-active="false"><span class="num">02</span>Trigger Diff</button>
              <button type="button" class="stage-tab" role="tab" id="stage-tab-2" aria-controls="stage-panel-2" aria-selected="false" tabindex="-1" data-step="2" data-active="false"><span class="num">03</span>Changes Table</button>
              <button type="button" class="stage-tab" role="tab" id="stage-tab-3" aria-controls="stage-panel-3" aria-selected="false" tabindex="-1" data-step="3" data-active="false"><span class="num">04</span>xid8 Export</button>
            </div>

            <div class="telemetry-body">
              <div class="panel-stack">
                <div class="telemetry-panel" id="stage-panel-0" role="tabpanel" aria-labelledby="stage-tab-0" data-panel="0" data-active="true" set:html={trace0Html} />
                <div class="telemetry-panel" id="stage-panel-1" role="tabpanel" aria-labelledby="stage-tab-1" data-panel="1" data-active="false" aria-hidden="true" inert set:html={trace1Html} />
                <div class="telemetry-panel" id="stage-panel-2" role="tabpanel" aria-labelledby="stage-tab-2" data-panel="2" data-active="false" aria-hidden="true" inert set:html={trace2Html} />
                <div class="telemetry-panel" id="stage-panel-3" role="tabpanel" aria-labelledby="stage-tab-3" data-panel="3" data-active="false" aria-hidden="true" inert set:html={trace3Html} />
              </div>
              <div class="panel-stack" aria-live="polite">
                <div class="trace-caption-item" data-caption="0" data-active="true">
                  Unpadded base64url can never contain <code class="ic">*/</code> or inject SQL. IDs only — no names, emails, or IPs leak into <code class="ic">pg_stat_activity</code>.
                </div>
                <div class="trace-caption-item" data-caption="1" data-active="false" aria-hidden="true" inert>
                  No-op updates and excluded-column-only edits write nothing. Malformed payloads store <code class="ic">actor = NULL</code> and never abort the write.
                </div>
                <div class="trace-caption-item" data-caption="2" data-active="false" aria-hidden="true" inert>
                  Monthly-partitioned table owned by a <code class="ic">NOLOGIN</code> role. App roles get <code class="ic">SELECT</code> only — tamper writes are denied by Postgres.
                </div>
                <div class="trace-caption-item" data-caption="3" data-active="false" aria-hidden="true" inert>
                  Exports JSON Lines or CSV on demand with stable <code class="ic">event_id</code> deduplication — no 24/7 consumer and no WAL replication slot.
                </div>
              </div>
            </div>

            <div class="ledger-strip panel-stack">
              <div class="ledger-strip-row" data-ledger="0" data-active="true">
                <span>decoded: <strong style="color:var(--accent);">user:usr_42</strong> · 10.4 ns cached tag</span>
                <span class="pill pill-accent">NO EXTRA TX</span>
              </div>
              <div class="ledger-strip-row" data-ledger="1" data-active="false" aria-hidden="true" inert>
                <span>trigger diff · <strong style="color:var(--ink);">public.invoice</strong> · UPDATE</span>
                <span style="display:inline-flex;gap:0.4rem;">
                  <span class="pill pill-before">− open</span>
                  <span class="pill pill-after">+ paid</span>
                </span>
              </div>
              <div class="ledger-strip-row" data-ledger="2" data-active="false" aria-hidden="true" inert>
                <span>xact_id <strong style="color:var(--ink);">48291044</strong> · auditstream.changes</span>
                <span class="pill pill-after">SELECT-ONLY APP ROLE</span>
              </div>
              <div class="ledger-strip-row" data-ledger="3" data-active="false" aria-hidden="true" inert>
                <span>window <strong style="color:var(--ink);">xact_id &lt; pg_snapshot_xmin()</strong></span>
                <span class="pill pill-accent">1,428 JSONL ACKED</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ======================================================================
         INTERACTIVE PROTOCOL WORKBENCH — Try real base64url + PG trigger live
         ====================================================================== -->
    <LiveWorkbench />

    <!-- ======================================================================
         SECTION 01 — ATTRIBUTION & AI AGENT ACTORS (auditstream-js)
         ====================================================================== -->
    <section class="section section-alt" id="attribution">
      <div class="shell split">
        <div class="reveal">
          <div class="eyebrow">§01 · ATTRIBUTION &amp; CONTRACT</div>
          <h2 class="h2" style="margin-top:0.85rem;">Author in a trailing comment, not a pinned session.</h2>
          <p class="lead" style="margin-top:1.1rem;">
            Application code never writes audit rows itself. <code class="ic">audit.as()</code> awaits your
            writes inside <code class="ic">AsyncLocalStorage.run()</code> and appends an unpadded base64url
            <code class="ic">sqlcommenter</code> tag — supporting humans, API keys, services, and
            <strong style="color:var(--ink);font-weight:600;">AI agents acting <code class="ic">onBehalfOf</code> a user</strong>.
          </p>
          <p class="lead" style="margin-top:0.85rem;">
            Because comments stay on the statement, standalone Prisma 7 queries need no explicit transaction
            and never pin connections on RDS Proxy. Malformed payloads never abort your write.
          </p>

          <div class="callout-pair">
            <div class="callout-cell">
              <div class="spec-k">Trailing comment (default)</div>
              <div class="spec-v" style="color:var(--after);white-space:normal;">10.4 ns cached tag · Pool-safe</div>
            </div>
            <div class="callout-cell">
              <div class="spec-k">set_config (fallback)</div>
              <div class="spec-v" style="color:var(--ink-2);white-space:normal;">9.3 ns cached JSON · Explicit tx</div>
            </div>
          </div>

          <div class="resolution-strip">
            <span style="color:var(--ink-3);">ACTOR PRECEDENCE:</span>
            <span style="color:var(--accent);">1. set_config</span> →
            <span style="color:var(--accent);">2. /*auditstream='…'*/</span> →
            <span>3. request.jwt.claims (Supabase)</span> →
            <span>4. session_user</span>
          </div>
        </div>

        <div class="plate plate-reg reveal">
          <div class="plate-bar plate-tab-bar">
            <div class="tabs" id="adapter-tabs" role="tablist" aria-label="TypeScript adapter examples">
              <button type="button" class="tab" role="tab" id="adapter-tab-prisma" aria-controls="adapter-panel-prisma" data-adapter="prisma" aria-selected="true">Prisma 7</button>
              <button type="button" class="tab" role="tab" id="adapter-tab-drizzle" aria-controls="adapter-panel-drizzle" data-adapter="drizzle" aria-selected="false" tabindex="-1">Drizzle</button>
              <button type="button" class="tab" role="tab" id="adapter-tab-middleware" aria-controls="adapter-panel-middleware" data-adapter="middleware" aria-selected="false" tabindex="-1">Middleware</button>
              <button type="button" class="tab" role="tab" id="adapter-tab-node" aria-controls="adapter-panel-node" data-adapter="node" aria-selected="false" tabindex="-1">Node / App</button>
            </div>
            <button type="button" class="chip-btn" id="copy-adapter" data-copy={prismaRaw} style="height:1.65rem;flex-shrink:0;">Copy</button>
          </div>
          <div class="panel-stack">
            <div class="tab-panel" id="adapter-panel-prisma" role="tabpanel" aria-labelledby="adapter-tab-prisma" data-adapter-panel="prisma" data-active="true" set:html={prismaHtml} />
            <div class="tab-panel" id="adapter-panel-drizzle" role="tabpanel" aria-labelledby="adapter-tab-drizzle" data-adapter-panel="drizzle" data-active="false" aria-hidden="true" inert set:html={drizzleHtml} />
            <div class="tab-panel" id="adapter-panel-middleware" role="tabpanel" aria-labelledby="adapter-tab-middleware" data-adapter-panel="middleware" data-active="false" aria-hidden="true" inert set:html={middlewareHtml} />
            <div class="tab-panel" id="adapter-panel-node" role="tabpanel" aria-labelledby="adapter-tab-node" data-adapter-panel="node" data-active="false" aria-hidden="true" inert set:html={nodeHtml} />
          </div>
          <div class="plate-bar" style="border-top:1px solid var(--rule);border-bottom:0;flex-wrap:nowrap;">
            <span id="adapter-filename" class="adapter-foot-name">@auditstream/prisma · auditstream() SQL comments plugin</span>
            <span class="pill pill-accent">ESM only · spec 0.1</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ======================================================================
         SECTION 02 — PARTITIONED APPEND-ONLY HISTORY TABLE
         ====================================================================== -->
    <section class="section" id="history">
      <div class="shell split">
        <div class="reveal">
          <div class="eyebrow">§02 · AUDITSTREAM.CHANGES</div>
          <h2 class="h2" style="margin-top:0.85rem;">The history table <em>is</em> the product.</h2>
          <p class="lead" style="margin-top:1.1rem;">
            <code class="ic">auditstream.changes</code> is partitioned by month on <code class="ic">occurred_at</code>,
            owned by a dedicated <code class="ic">NOLOGIN</code> role, and written exclusively through
            <code class="ic">SECURITY DEFINER</code> triggers. Your application role receives
            <code class="ic">SELECT</code> only — its <code class="ic">INSERT</code>, <code class="ic">UPDATE</code>,
            and <code class="ic">DELETE</code> tamper attempts are rejected by Postgres itself.
          </p>
          <p class="lead" style="margin-top:0.85rem;">
            INSERT and DELETE fire once per statement via transition tables (<code class="ic">REFERENCING NEW/OLD TABLE</code>);
            UPDATE stays row-level with <code class="ic">WHEN (OLD.* IS DISTINCT FROM NEW.*)</code> so no-op and
            excluded-column writes record nothing. Lookups use a partial <code class="ic">HASH</code> index on
            <code class="ic">record_id</code> alongside a monthly BRIN on <code class="ic">occurred_at</code>.
          </p>
        </div>

        <div class="plate plate-reg reveal">
          <div class="plate-bar plate-tab-bar">
            <div class="tabs" id="rowview-tabs" role="tablist" aria-label="Inspect committed audit row">
              <button type="button" class="tab" role="tab" id="rowview-tab-diff" aria-controls="rowview-panel-diff" data-rowview="diff" aria-selected="true">Diff view</button>
              <button type="button" class="tab" role="tab" id="rowview-tab-cli" aria-controls="rowview-panel-cli" data-rowview="cli" aria-selected="false" tabindex="-1">CLI history</button>
              <button type="button" class="tab" role="tab" id="rowview-tab-sql" aria-controls="rowview-panel-sql" data-rowview="sql" aria-selected="false" tabindex="-1">Query SQL</button>
              <button type="button" class="tab" role="tab" id="rowview-tab-jsonl" aria-controls="rowview-panel-jsonl" data-rowview="jsonl" aria-selected="false" tabindex="-1">Export JSONL</button>
            </div>
            <button type="button" class="chip-btn" id="copy-rowview" data-copy={diffCopyRaw} style="height:1.65rem;flex-shrink:0;">Copy</button>
          </div>

