---
import "@fontsource/ibm-plex-sans/latin-400.css";
import "@fontsource/ibm-plex-sans/latin-500.css";
import "@fontsource/ibm-plex-sans/latin-600.css";
import "@fontsource/ibm-plex-mono/latin-400.css";
import "@fontsource/ibm-plex-mono/latin-500.css";
import "@fontsource/ibm-plex-mono/latin-600.css";
import ibmSans400Url from "@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-400-normal.woff2?url";
import ibmSans600Url from "@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-600-normal.woff2?url";
import ibmMono400Url from "@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url";
import "../styles/tokens.css";

import Navbar from "../components/Navbar.astro";
import SearchModal from "../components/SearchModal.astro";

interface Props {
  title: string;
  description: string;
  currentPath?: string;
  showProgress?: boolean;
  noindex?: boolean;
}

const {
  title,
  description,
  currentPath = "/",
  showProgress = true,
  noindex = false,
} = Astro.props;

function normalizeCanonicalPath(path: string): string {
  if (!path || path === "/") return "/";
  const clean = path.startsWith("/") ? path : `/${path}`;
  if (clean.endsWith("/") || /\.[a-z0-9]+$/i.test(clean)) return clean;
  return `${clean}/`;
}

const siteBase = Astro.site ?? new URL("https://auditstream.dev");
const normalizedPath = normalizeCanonicalPath(currentPath);
const canonicalUrl = new URL(normalizedPath, siteBase).toString();
const ogImageUrl = new URL("/og-image.png", siteBase).toString();
const jsonLd =
  normalizedPath === "/"
    ? JSON.stringify({
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        name: "Auditstream",
        applicationCategory: "DeveloperApplication",
        operatingSystem: "Linux, macOS, Windows",
        license: "https://opensource.org/licenses/MIT",
        url: "https://auditstream.dev",
        codeRepository: "https://github.com/auditstream/auditstream",
        description,
      })
    : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalUrl} />}
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#fafaf8" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="preload" href={ibmSans400Url} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={ibmSans600Url} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={ibmMono400Url} as="font" type="font/woff2" crossorigin />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Auditstream" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Auditstream — Open-source audit trail engine for PostgreSQL 15–19" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    {jsonLd && <script type="application/ld+json" is:inline set:html={jsonLd} />}
  </head>
  <body id="top">
    <a href="#main-content" class="skip-link">Skip to content</a>
    <Navbar currentPath={normalizedPath} />
    {showProgress && <div class="progress-rail" aria-hidden="true" />}

    <slot />

    <SearchModal />

    <script>
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      // Smooth jump ONLY on explicit anchor link clicks — native wheel/trackpad scroll stays untouched
      document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((a) => {
        a.addEventListener("click", (e) => {
          const id = a.getAttribute("href");
          if (!id || id === "#") return;
          const target = document.querySelector<HTMLElement>(id);
          if (target) {
            e.preventDefault();
            target.scrollIntoView({ behavior: reduceMotion ? "auto" : "smooth", block: "start" });
          }
        });
      });

      if (!CSS.supports("animation-timeline: scroll()")) {
        const rail = document.querySelector<HTMLElement>(".progress-rail");
        const update = () => {
          const max = document.documentElement.scrollHeight - window.innerHeight;
          if (rail && max > 0) rail.style.transform = `scaleX(${Math.min(1, window.scrollY / max)})`;
        };
        window.addEventListener("scroll", update, { passive: true });
        update();
      }

      function extractCleanCode(container: Element | null): string {
        if (!container) return "";
        const override = container.getAttribute("data-copy-override");
        if (override !== null) return override;
        const pre = container.tagName === "PRE" ? container : container.querySelector("pre");
        if (!pre) return "";
        const clone = pre.cloneNode(true) as HTMLElement;
        clone.querySelectorAll(".ln").forEach((ln) => ln.remove());
        return (clone.textContent || "").replace(/\n$/, "");
      }

      // Event delegation so static, tabbed & build-time Docs Copy buttons work uniformly
      document.addEventListener("click", async (e) => {
        const btn = (e.target as HTMLElement | null)?.closest<HTMLButtonElement>(
          "[data-copy], [data-copy-target], .doc-copy-btn"
        );
        if (!btn) return;

        let text = "";
        if (btn.hasAttribute("data-copy")) {
          text = btn.getAttribute("data-copy") || "";
        } else if (btn.hasAttribute("data-copy-target")) {
          const sel = btn.getAttribute("data-copy-target") || "";
          const root = sel ? document.querySelector(sel) : null;
          const activePanel = root?.querySelector<HTMLElement>('[data-active="true"]') ?? root;
          text = extractCleanCode(activePanel);
        } else if (btn.classList.contains("doc-copy-btn")) {
          const frame = btn.closest(".doc-code-frame");
          text = extractCleanCode(frame);
        }

        if (!text) return;
        try {
          await navigator.clipboard.writeText(text);
          const prev = btn.dataset.copyLabel || btn.textContent || "Copy";
          btn.dataset.copyLabel = prev;
          btn.textContent = "Copied";
          clearTimeout(Number(btn.dataset.copyTimer || 0));
          btn.dataset.copyTimer = String(
            window.setTimeout(() => {
              btn.textContent = prev;
            }, 1400)
          );
        } catch {}
      });
    </script>
  </body>
</html>
