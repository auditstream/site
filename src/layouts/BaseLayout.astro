---
import "@fontsource/ibm-plex-mono/latin-400.css";
import "@fontsource/ibm-plex-mono/latin-500.css";
import "@fontsource/ibm-plex-mono/latin-600.css";
import monaSansUrl from "@fontsource-variable/mona-sans/files/mona-sans-latin-wdth-normal.woff2?url";
import ibmMono400Url from "@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url";
import "../styles/tokens.css";

import Navbar from "../components/Navbar.astro";
import SearchModal from "../components/SearchModal.astro";

interface Props {
  title: string;
  description: string;
  currentPath?: string;
  showProgress?: boolean;
}

const {
  title,
  description,
  currentPath = "/",
  showProgress = true,
} = Astro.props;

const siteBase = Astro.site ?? new URL("https://auditstream.dev");
const canonicalUrl = new URL(currentPath, siteBase).toString();
const ogImageUrl = new URL("/og-image.png", siteBase).toString();
const jsonLd = currentPath === "/" ? JSON.stringify({
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Auditstream",
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Linux, macOS, Windows",
  license: "https://opensource.org/licenses/MIT",
  url: "https://auditstream.dev",
  codeRepository: "https://github.com/auditstream/auditstream",
  description,
}) : null;

const fontFaceCss = `@font-face{font-family:'Mona Sans Variable';font-style:normal;font-display:swap;font-weight:200 900;font-stretch:75% 125%;src:url(${monaSansUrl}) format('woff2-variations');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;}@font-face{font-family:'Mona Sans Fallback';src:local('Arial');ascent-override:96%;descent-override:24%;line-gap-override:0%;size-adjust:102%;}`;
---

<!doctype html>
<html lang="en" data-mode="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="theme-color" content="#0c0f13" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href={monaSansUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={ibmMono400Url} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={fontFaceCss} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Auditstream" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Auditstream — Open-source audit trail engine for PostgreSQL 15–19" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    {jsonLd && <script type="application/ld+json" is:inline set:html={jsonLd} />}
    <!-- Blocking micro-script prevents light/dark FOUC -->
    <script is:inline>
      (function () {
        var saved = localStorage.getItem("auditstream-mode");
        var mode = saved === "light" || saved === "dark" ? saved : "dark";
        document.documentElement.setAttribute("data-mode", mode);
        var tc = document.querySelector('meta[name="theme-color"]');
        if (tc) tc.setAttribute("content", mode === "light" ? "#efeee8" : "#0c0f13");
      })();
    </script>
  </head>
  <body id="top">
    <Navbar currentPath={currentPath} />
    {showProgress && <div class="progress-rail" aria-hidden="true" />}

    <slot />

    <SearchModal />

    <!-- Theme toggle, copy buttons & native smooth anchor clicks (no wheel hijacking!) -->
    <script>
      const htmlEl = document.documentElement;
      const modeLabel = document.getElementById("mode-label");
      const modeBtn = document.getElementById("btn-mode");

      function syncModeLabel() {
        const mode = htmlEl.getAttribute("data-mode") || "dark";
        if (modeLabel) modeLabel.textContent = mode === "dark" ? "Light" : "Dark";
        const tc = document.querySelector('meta[name="theme-color"]');
        if (tc) tc.setAttribute("content", mode === "light" ? "#efeee8" : "#0c0f13");
      }

      function toggleMode() {
        const next = htmlEl.getAttribute("data-mode") === "dark" ? "light" : "dark";
        htmlEl.setAttribute("data-mode", next);
        localStorage.setItem("auditstream-mode", next);
        syncModeLabel();
      }

      syncModeLabel();
      modeBtn?.addEventListener("click", toggleMode);
      window.addEventListener("keydown", (e) => {
        const inField = /INPUT|TEXTAREA|SELECT/.test((e.target as HTMLElement)?.tagName || "");
        const modalOpen = !document.getElementById("search-modal")?.hidden;
        if (!inField && !modalOpen && !e.metaKey && !e.ctrlKey && !e.altKey && e.key.toLowerCase() === "l") {
          toggleMode();
        }
      });

      // Smooth jump ONLY on anchor link clicks — native compositor scroll stays untouched for wheel/trackpad
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((a) => {
        a.addEventListener("click", (e) => {
          const id = a.getAttribute("href");
          if (!id || id === "#") return;
          const target = document.querySelector<HTMLElement>(id);
          if (target) {
            e.preventDefault();
            target.scrollIntoView({ behavior: reduceMotion ? "auto" : "smooth", block: "start" });
          }
        });
      });

      if (!CSS.supports("animation-timeline: scroll()")) {
        const rail = document.querySelector<HTMLElement>(".progress-rail");
        const update = () => {
          const max = document.documentElement.scrollHeight - window.innerHeight;
          if (rail && max > 0) rail.style.transform = `scaleX(${Math.min(1, window.scrollY / max)})`;
        };
        window.addEventListener("scroll", update, { passive: true });
        update();
      }

      // Event delegation so static & progressive Copy buttons (including Docs <pre>) work uniformly
      document.addEventListener("click", async (e) => {
        const btn = (e.target as HTMLElement | null)?.closest<HTMLButtonElement>("[data-copy]");
        if (!btn) return;
        const text = btn.getAttribute("data-copy") || "";
        try {
          await navigator.clipboard.writeText(text);
          const prev = btn.dataset.copyLabel || btn.textContent || "Copy";
          btn.dataset.copyLabel = prev;
          btn.textContent = "Copied";
          clearTimeout(Number(btn.dataset.copyTimer || 0));
          btn.dataset.copyTimer = String(
            window.setTimeout(() => {
              btn.textContent = prev;
            }, 1400)
          );
        } catch {}
      });
    </script>
  </body>
</html>
