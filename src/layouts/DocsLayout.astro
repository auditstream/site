---
import { getCollection } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import BrandMark from "../components/BrandMark.astro";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description: string;
  eyebrow?: string;
  currentSlug: string;
  headings: Heading[];
}

const { title, description, currentSlug, headings } = Astro.props;

const allDocs = (await getCollection("docs")).sort((a, b) => a.data.order - b.data.order);
const sectionOrder = ["Get Started", "SDKs & Languages", "Operate", "Reference"] as const;
const grouped = sectionOrder
  .map((sec) => ({
    section: sec,
    items: allDocs.filter((d) => d.data.section === sec),
  }))
  .filter((g) => g.items.length > 0);

const currentIdx = allDocs.findIndex((d) => d.id === currentSlug);
const prevDoc = currentIdx > 0 ? allDocs[currentIdx - 1] : null;
const nextDoc = currentIdx >= 0 && currentIdx < allDocs.length - 1 ? allDocs[currentIdx + 1] : null;

const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);

function docHref(id: string) {
  return id === "index" ? "/docs/" : `/docs/${id}/`;
}
---

<BaseLayout
  title={`${title} — Auditstream Docs`}
  description={description}
  currentPath={docHref(currentSlug)}
  showProgress={true}
>
  <div class="docs-frame docs-layout">
    <aside class="docs-sidebar" aria-label="Documentation navigation">
      <!-- Mobile-only collapsible sidebar disclosure (< 960px) -->
      <details class="docs-nav-disclosure">
        <summary class="docs-nav-summary">
          <span class="mono">Docs · {title}</span>
          <span class="docs-nav-caret" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="m6 9 6 6 6-6" />
            </svg>
          </span>
        </summary>
        <nav class="docs-sidebar-mobile-list" aria-label="Documentation sections">
          {grouped.map((g) => (
            <div class="docs-group">
              <div class="docs-group-title">{g.section}</div>
              <ul>
                {g.items.map((item) => (
                  <li>
                    <a
                      href={docHref(item.id)}
                      aria-current={item.id === currentSlug ? "page" : undefined}
                    >
                      <span>{item.data.title}</span>
                      {item.data.badge && <span class="docs-nav-badge">{item.data.badge}</span>}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </nav>
      </details>

      <!-- Desktop permanent sidebar (>= 960px, pure CSS, zero JS / zero SSR flash) -->
      <nav class="docs-sidebar-nav" aria-label="Documentation sections">
        {grouped.map((g) => (
          <div class="docs-group">
            <div class="docs-group-title">{g.section}</div>
            <ul>
              {g.items.map((item) => (
                <li>
                  <a
                    href={docHref(item.id)}
                    aria-current={item.id === currentSlug ? "page" : undefined}
                  >
                    <span>{item.data.title}</span>
                    {item.data.badge && <span class="docs-nav-badge">{item.data.badge}</span>}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </aside>

    <main id="main-content" class="docs-main">
      <article class="docs-article" data-pagefind-body>
        <header class="docs-header">
          <h1 class="docs-title">{title}</h1>
          <p class="lead docs-desc">{description}</p>

          {toc.length > 0 && (
            <details class="docs-toc-mobile">
              <summary class="docs-toc-mobile-summary">
                <span class="mono">On this page</span>
                <span class="docs-nav-caret" aria-hidden="true">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="m6 9 6 6 6-6" />
                  </svg>
                </span>
              </summary>
              <ul class="docs-toc-mobile-list">
                {toc.map((h) => (
                  <li class={h.depth === 3 ? "is-sub" : ""}>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
              </ul>
            </details>
          )}
        </header>

        <div class="prose">
          <slot />
        </div>

        <nav class="docs-pager" aria-label="Adjacent pages">
          {prevDoc ? (
            <a href={docHref(prevDoc.id)} class="pager-card">
              <span class="pager-dir mono">← Previous</span>
              <strong>{prevDoc.data.title}</strong>
            </a>
          ) : (
            <div />
          )}
          {nextDoc ? (
            <a href={docHref(nextDoc.id)} class="pager-card pager-next">
              <span class="pager-dir mono">Next →</span>
              <strong>{nextDoc.data.title}</strong>
            </a>
          ) : (
            <div />
          )}
        </nav>
      </article>
    </main>

    <aside class="docs-toc" aria-label="On this page">
      {toc.length > 0 && (
        <div class="docs-toc-inner">
          <div class="docs-group-title">On this page</div>
          <ul>
            {toc.map((h) => (
              <li class={h.depth === 3 ? "is-sub" : ""}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </aside>
  </div>

  <footer class="docs-footer">
    <div class="docs-footer-inner">
      <a href="/" class="brand">
        <BrandMark size={18} />
        <span>Auditstream</span>
      </a>
      <div class="docs-footer-links">
        <a href="/docs/">Docs</a>
        <a href="/docs/evidence/">Benchmarks</a>
        <a href="https://github.com/auditstream/auditstream" target="_blank" rel="noopener noreferrer">Engine</a>
        <a href="https://github.com/auditstream/auditstream-js" target="_blank" rel="noopener noreferrer">JS SDK</a>
        <a href="https://github.com/auditstream/auditstream/blob/main/LICENSE" target="_blank" rel="noopener noreferrer">MIT License</a>
        <a href="https://github.com/auditstream/auditstream/security/policy" target="_blank" rel="noopener noreferrer">Security</a>
      </div>
    </div>
  </footer>
</BaseLayout>

<style>
  .docs-layout {
    width: 100%;
    max-width: 84rem;
    margin: 0 auto;
    padding: 2.5rem clamp(1.25rem, 2.5vw, 1.75rem) 5rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
    min-height: calc(100vh - 8rem);
  }

  .docs-main {
    min-width: 0;
  }

  .docs-article {
    max-width: 47rem;
  }

  @media (max-width: 959px) {
    .docs-layout {
      padding-top: 1.25rem;
      gap: 1.25rem;
    }
  }

  @media (min-width: 960px) and (max-width: 1279px) {
    .docs-layout {
      grid-template-columns: 12.75rem minmax(0, 47rem);
      gap: 2.25rem;
      padding-inline: clamp(1rem, 2.5vw, 1.75rem);
      justify-content: center;
    }
  }

  @media (min-width: 1280px) {
    .docs-layout {
      grid-template-columns: 13.5rem minmax(0, 47rem) 12.5rem;
      gap: 2.5rem;
      justify-content: center;
    }
  }

  .docs-nav-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 2.75rem;
    padding: 0.65rem 0.9rem;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-md);
    background: var(--surface);
    font-size: 0.8125rem;
    color: var(--ink);
    cursor: pointer;
    list-style: none;
  }

  .docs-nav-summary::-webkit-details-marker,
  .docs-toc-mobile-summary::-webkit-details-marker {
    display: none;
  }

  .docs-nav-caret {
    display: inline-flex;
    align-items: center;
    color: var(--ink-3);
    transition: transform var(--dur-quick) var(--ease-out);
  }

  details[open] > summary .docs-nav-caret {
    transform: rotate(180deg);
  }

  .docs-sidebar-mobile-list {
    margin-top: 0.75rem;
    padding: 1rem 1rem 0.25rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius-md);
    background: var(--surface);
  }

  .docs-sidebar-nav {
    display: none;
  }

  @media (min-width: 960px) {
    .docs-nav-disclosure {
      display: none;
    }
    .docs-sidebar-nav {
      display: block;
      position: sticky;
      top: 5.5rem;
      max-height: calc(100vh - 6.5rem);
      overflow-y: auto;
      scrollbar-width: thin;
    }
  }

  .docs-toc-inner {
    position: sticky;
    top: 5.5rem;
    max-height: calc(100vh - 6.5rem);
    overflow-y: auto;
    scrollbar-width: thin;
  }

  .docs-group {
    margin-bottom: 1.65rem;
  }

  .docs-group-title {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--ink-3);
    margin-bottom: 0.6rem;
  }

  .docs-sidebar ul,
  .docs-toc ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 1px solid var(--rule);
  }

  .docs-sidebar a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.4rem 0 0.4rem 0.9rem;
    margin-left: -1px;
    border-left: 2px solid transparent;
    font-size: 0.875rem;
    color: var(--ink-2);
    transition: color 140ms, border-color 140ms;
  }

  .docs-toc a {
    display: block;
    padding: 0.4rem 0 0.4rem 0.9rem;
    margin-left: -1px;
    border-left: 2px solid transparent;
    font-size: 0.875rem;
    color: var(--ink-2);
    transition: color 140ms, border-color 140ms;
  }

  .docs-nav-badge {
    flex-shrink: 0;
    padding: 0.04rem 0.44rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--rule);
    background: var(--ground-2);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.3;
    color: var(--ink-3);
  }

  .prose :global(.docs-card-head) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .prose :global(.docs-card-badge) {
    flex-shrink: 0;
    padding: 0.04rem 0.45rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--rule);
    background: var(--ground-2);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.3;
    color: var(--ink-3);
  }

  .docs-sidebar a:hover,
  .docs-toc a:hover {
    color: var(--ink);
  }

  .docs-sidebar a[aria-current="page"],
  .docs-toc a[aria-current="location"] {
    color: var(--accent);
    border-left-color: var(--accent);
    font-weight: 600;
  }

  /* Collapsible mobile/tablet On this page (< 1280px) */
  .docs-toc-mobile {
    margin-top: 1.35rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius-md);
    background: var(--surface);
  }

  .docs-toc-mobile-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 2.5rem;
    padding: 0.55rem 0.9rem;
    font-size: 0.8125rem;
    color: var(--ink-2);
    cursor: pointer;
    list-style: none;
  }

  .docs-toc-mobile-list {
    list-style: none;
    margin: 0;
    padding: 0.4rem 0.9rem 0.75rem;
    border-top: 1px solid var(--rule);
  }

  .docs-toc-mobile-list a {
    display: block;
    padding: 0.5rem 0;
    font-size: 0.8125rem;
    color: var(--ink-2);
  }

  .docs-toc-mobile-list a:hover {
    color: var(--accent);
  }

  .docs-toc-mobile-list li.is-sub a {
    padding-left: 1rem;
    color: var(--ink-3);
  }

  .docs-toc {
    display: none;
  }

  @media (min-width: 1280px) {
    .docs-toc-mobile {
      display: none;
    }
    .docs-toc {
      display: block;
    }
  }

  .docs-toc a {
    font-size: 0.8125rem;
    line-height: 1.4;
  }

  .docs-toc li.is-sub a {
    padding-left: 1.45rem;
    color: var(--ink-3);
  }

  .docs-header {
    padding-bottom: 1.5rem;
    margin-bottom: 1.75rem;
    border-bottom: 1px solid var(--rule);
  }

  .docs-title {
    margin: 0;
    font-size: clamp(1.85rem, 3vw, 2.35rem);
    font-weight: 600;
    letter-spacing: -0.028em;
    line-height: 1.12;
    color: var(--ink);
    text-wrap: balance;
  }

  .docs-desc {
    margin-top: 0.7rem;
    max-width: none;
    font-size: 1.03125rem;
    line-height: 1.58;
    color: var(--ink-2);
    text-wrap: pretty;
  }

  /* Calm high-comfort editorial technical prose */
  .prose :global(h2) {
    margin: 2.65rem 0 0.85rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
    max-width: none;
    font-size: 1.3125rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.25;
    color: var(--ink);
    scroll-margin-top: 5rem;
  }

  .prose :global(h2:first-child) {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }

  .prose :global(h3) {
    margin: 1.85rem 0 0.55rem;
    max-width: none;
    font-size: 1.03125rem;
    font-weight: 600;
    letter-spacing: -0.012em;
    line-height: 1.32;
    color: var(--ink);
    scroll-margin-top: 5rem;
  }

  .prose :global(h4) {
    margin: 1.5rem 0 0.45rem;
    max-width: none;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--ink);
    scroll-margin-top: 5rem;
  }

  .prose :global(.heading-anchor) {
    display: inline-block;
    margin-left: 0.45rem;
    padding: 0 0.2rem;
    color: var(--ink-3);
    text-decoration: none;
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 0.85em;
    opacity: 0;
    transition: opacity 140ms, color 140ms;
  }

  .prose :global(.heading-anchor::before) {
    content: "#";
  }

  .prose :global(h2:hover .heading-anchor),
  .prose :global(h3:hover .heading-anchor),
  .prose :global(.heading-anchor:focus-visible) {
    opacity: 1;
    color: var(--accent);
  }

  .prose :global(p),
  .prose :global(li) {
    color: var(--ink-prose);
    line-height: 1.7;
    font-size: 0.9375rem;
    text-wrap: pretty;
  }

  .prose :global(p) {
    margin: 0.85rem 0;
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol),
  .prose :global(blockquote) {
    max-width: none;
  }

  .prose :global(strong) {
    color: var(--ink);
    font-weight: 600;
  }

  .prose :global(a:not(.heading-anchor):not(.docs-card)) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.22em;
  }

  .prose :global(a:not(.heading-anchor):not(.docs-card):hover) {
    color: var(--accent-hover);
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: 0.85rem 0 1.2rem;
    padding-left: 1.25rem;
  }

  .prose :global(li) {
    margin: 0.48rem 0;
  }

  .prose :global(li > strong:first-child) {
    color: var(--ink);
    font-weight: 600;
  }

  .prose :global(:not(pre) > code) {
    font-family: var(--font-mono);
    font-size: 0.84em;
    font-weight: 400;
    padding: 0.08em 0.3em;
    border-radius: 4px;
    background: var(--code-bg);
    border: none;
    color: var(--ink);
    white-space: nowrap;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  .prose :global(strong > code) {
    font-weight: 600;
  }

  .prose :global(:not(pre) > code.ic-wrap) {
    white-space: normal;
    overflow-wrap: anywhere;
  }

  @media (min-width: 640px) {
    .prose :global(:not(pre) > code.ic-wrap) {
      white-space: nowrap;
    }
  }

  .prose :global(a:not(.heading-anchor):not(.docs-card) > code) {
    color: inherit;
  }

  .prose :global(.doc-code-frame) {
    width: 100%;
    margin: 1.45rem 0;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-md);
    background: var(--surface);
    overflow: hidden;
  }

  .prose :global(.doc-code-bar) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.45rem 0.85rem;
    border-bottom: 1px solid var(--rule);
    background: var(--ground-2);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-3);
    letter-spacing: 0.04em;
  }

  .prose :global(.doc-copy-btn) {
    min-height: 1.75rem;
    padding: 0 0.55rem;
    letter-spacing: 0;
  }

  .prose :global(.doc-code-frame pre) {
    margin: 0;
    border: 0;
    border-radius: 0;
  }

  .prose :global(pre) {
    width: 100%;
    margin: 1.45rem 0;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-md);
    background: var(--surface) !important;
  }

  .prose :global(.table-wrap) {
    position: relative;
    width: 100%;
    margin: 1.65rem 0;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-md);
    background-color: var(--surface);
    background-image:
      linear-gradient(90deg, var(--surface) 30%, rgba(255, 255, 255, 0)),
      linear-gradient(270deg, var(--surface) 30%, rgba(255, 255, 255, 0)),
      linear-gradient(90deg, rgba(15, 23, 42, 0.14), rgba(15, 23, 42, 0)),
      linear-gradient(270deg, rgba(15, 23, 42, 0.14), rgba(15, 23, 42, 0));
    background-position: 0 0, 100% 0, 0 0, 100% 0;
    background-repeat: no-repeat;
    background-size: 32px 100%, 32px 100%, 20px 100%, 20px 100%;
    background-attachment: local, local, scroll, scroll;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    scrollbar-color: var(--rule-strong) transparent;
  }

  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 0;
    border: 0;
    background: transparent;
    font-size: 0.875rem;
    line-height: 1.5;
    display: table;
  }

  .prose :global(th),
  .prose :global(td) {
    padding: 0.625rem 0.75rem;
    border-bottom: 1px solid var(--rule);
    text-align: left;
    vertical-align: top;
    color: var(--ink-prose);
    font-variant-numeric: tabular-nums;
    overflow-wrap: break-word;
  }

  .prose :global(th:first-child),
  .prose :global(td:first-child) {
    padding-left: 1rem;
  }

  .prose :global(th:last-child),
  .prose :global(td:last-child) {
    padding-right: 1rem;
  }

  .prose :global(th[align="right"]),
  .prose :global(td[align="right"]) {
    text-align: right;
  }

  .prose :global(th[align="center"]),
  .prose :global(td[align="center"]) {
    text-align: center;
  }

  .prose :global(td[align="right"]) {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
    font-variant-ligatures: none;
    white-space: nowrap;
  }

  .prose :global(td[align="center"]) {
    white-space: nowrap;
  }

  .prose :global(td code),
  .prose :global(th code) {
    white-space: nowrap;
  }

  .prose :global(tbody tr:last-child td) {
    border-bottom: 0;
  }

  .prose :global(thead th) {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    line-height: 1.35;
    color: var(--ink-3);
    background: var(--ground-2);
    border-bottom: 1px solid var(--rule-strong);
    vertical-align: middle;
    white-space: nowrap;
  }

  .prose :global(thead th code) {
    background: transparent;
    padding: 0;
    font-size: 1em;
    color: var(--ink-2);
  }

  @media (max-width: 640px) {
    .prose :global(th),
    .prose :global(td) {
      padding: 0.55rem 0.65rem;
      font-size: 0.8125rem;
    }

    .prose :global(th:first-child),
    .prose :global(td:first-child) {
      padding-left: 0.75rem;
    }

    .prose :global(th:last-child),
    .prose :global(td:last-child) {
      padding-right: 0.75rem;
    }

    .prose :global(td:first-child) {
      min-width: 8.5rem;
    }
  }

  .prose :global(.table-caption-cmd) {
    display: inline-block;
    max-width: 100%;
    margin: -0.65rem 0 1.65rem;
    padding: 0.28rem 0.65rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius-sm);
    background: var(--surface);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--ink-2);
    overflow-x: auto;
    white-space: nowrap;
    scrollbar-width: thin;
    scrollbar-color: var(--rule-strong) transparent;
  }

  @media (max-width: 640px) {
    .prose :global(.table-caption-cmd) {
      white-space: normal;
      overflow-wrap: break-word;
    }
  }

  .prose :global(blockquote) {
    margin: 1.35rem 0;
    padding: 0.95rem 1.15rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius-md);
    background: var(--surface);
    color: var(--ink-2);
  }

  .prose :global(blockquote p) {
    font-size: 0.875rem;
    line-height: 1.62;
