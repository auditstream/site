---
// Instant client-side search modal powered by Pagefind (loaded lazily on first open — 0 KB until used)
const CORE_SHORTCUTS = [
  {
    url: "/docs/getting-started/",
    title: "Getting Started",
    excerpt: "CLI install channels, 60-second local demo, and supported database and SDK versions.",
  },
  {
    url: "/docs/typescript/",
    title: "TypeScript SDK",
    excerpt: "Prisma 7, Drizzle 0.45 & 1.x, Next.js 16, Hono/Express middleware, and AsyncLocalStorage rules.",
  },
  {
    url: "/docs/cli/",
    title: "CLI & Day-2 Ops",
    excerpt: "init, status, verify --fix, history, export-time redaction, and commit-safe xid8 cursors.",
  },
  {
    url: "/docs/cloud-and-security/",
    title: "Cloud, Poolers & Security",
    excerpt: "PgBouncer, Neon, Supavisor, NOLOGIN owner isolation, and tamper-resistance boundaries.",
  },
  {
    url: "/docs/evidence/",
    title: "Benchmarks & Limits",
    excerpt: "Durable disk PG 19, PgBouncer 2.4M tx stress proof, 500k-row scale, and honest limits.",
  },
];
---

<div
  class="search-backdrop"
  id="search-modal"
  hidden
  role="dialog"
  aria-modal="true"
  aria-label="Search documentation"
>
  <div class="search-dialog">
    <div class="search-head">
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        class="search-icon"
        aria-hidden="true"
      >
        <circle cx="11" cy="11" r="8" />
        <path d="m21 21-4.3-4.3" />
      </svg>
      <input
        type="search"
        id="search-input"
        class="search-input"
        role="combobox"
        aria-label="Search documentation"
        aria-expanded="false"
        aria-controls="search-results"
        aria-autocomplete="list"
        placeholder="Search docs, triggers, xid8, Prisma, Drizzle, benchmarks…"
        autocomplete="off"
        spellcheck="false"
      />
      <button type="button" class="chip-btn is-compact" id="close-search" aria-label="Close search">Esc</button>
    </div>

    <div class="search-meta-bar">
      <span id="search-status" aria-live="polite">Quick links · 5 core docs</span>
      <span>Pagefind</span>
    </div>

    <div class="search-results" id="search-results" role="listbox" aria-label="Search results">
      {CORE_SHORTCUTS.map((item, idx) => (
        <a
          id={`search-hit-${idx}`}
          class="search-hit"
          href={item.url}
          data-selected={idx === 0 ? "true" : "false"}
          aria-selected={idx === 0 ? "true" : "false"}
          role="option"
        >
          <div class="search-hit-title">{item.title}</div>
          <div class="search-hit-excerpt">{item.excerpt}</div>
        </a>
      ))}
    </div>

    <div class="search-empty" id="search-empty" hidden></div>

    <div class="search-foot">
      <span>↑↓ navigate · ↵ open · Esc close</span>
      <span>Press / or ⌘K anywhere</span>
    </div>
  </div>
</div>

<style>
  .search-icon {
    color: var(--ink-3);
    flex-shrink: 0;
  }
</style>

<script>
  const CORE_SHORTCUTS = [
    {
      url: "/docs/getting-started/",
      title: "Getting Started",
      excerpt: "CLI install channels, 60-second local demo, and supported database and SDK versions.",
    },
    {
      url: "/docs/typescript/",
      title: "TypeScript SDK",
      excerpt: "Prisma 7, Drizzle 0.45 & 1.x, Next.js 16, Hono/Express middleware, and AsyncLocalStorage rules.",
    },
    {
      url: "/docs/cli/",
      title: "CLI & Day-2 Ops",
      excerpt: "init, status, verify --fix, history, export-time redaction, and commit-safe xid8 cursors.",
    },
    {
      url: "/docs/cloud-and-security/",
      title: "Cloud, Poolers & Security",
      excerpt: "PgBouncer, Neon, Supavisor, NOLOGIN owner isolation, and tamper-resistance boundaries.",
    },
    {
      url: "/docs/evidence/",
      title: "Benchmarks & Limits",
      excerpt: "Durable disk PG 19, PgBouncer 2.4M tx stress proof, 500k-row scale, and honest limits.",
    },
  ];

  const modal = document.getElementById("search-modal");
  const dialog = modal?.querySelector<HTMLElement>(".search-dialog");
  const input = document.getElementById("search-input") as HTMLInputElement | null;
  const resultsEl = document.getElementById("search-results");
  const emptyEl = document.getElementById("search-empty");
  const statusEl = document.getElementById("search-status");
  const openBtn = document.getElementById("open-search");
  const closeBtn = document.getElementById("close-search");

  let pagefind: any = null;
  let pagefindLoading = false;
  let activeIndex = 0;
  let hits: Array<{ url: string; title: string; excerpt: string }> = CORE_SHORTCUTS;
  let lastFocused: HTMLElement | null = null;
  let querySeq = 0;

  function escapeHtml(raw: string): string {
    return raw.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
  }

  async function ensurePagefind() {
    if (pagefind) return pagefind;
    pagefindLoading = true;
    try {
      const pfPath = "/pagefind/pagefind.js";
      pagefind = await import(/* @vite-ignore */ pfPath);
      await pagefind.init();
      return pagefind;
    } catch {
      return null;
    } finally {
      pagefindLoading = false;
    }
  }

  function showEmptyState(statusText: string, bodyHtml: string) {
    if (statusEl) statusEl.textContent = statusText;
    if (resultsEl) {
      resultsEl.innerHTML = "";
      resultsEl.hidden = true;
    }
    if (emptyEl) {
      emptyEl.innerHTML = bodyHtml;
      emptyEl.hidden = false;
    }
    hits = [];
    activeIndex = -1;
    input?.removeAttribute("aria-activedescendant");
  }

  function syncActiveDescendant() {
    if (!input || !resultsEl) return;
    if (activeIndex >= 0 && activeIndex < hits.length) {
      const id = `search-hit-${activeIndex}`;
      input.setAttribute("aria-activedescendant", id);
      document.getElementById(id)?.scrollIntoView({ block: "nearest" });
    } else {
      input.removeAttribute("aria-activedescendant");
    }
  }

  function renderHits(statusText: string, escapeExcerpt: boolean) {
    if (!resultsEl || !emptyEl) return;
    if (statusEl) statusEl.textContent = statusText;
    emptyEl.hidden = true;
    resultsEl.hidden = false;
    resultsEl.innerHTML = hits
      .map(
        (h, i) => `
        <a id="search-hit-${i}" class="search-hit" href="${escapeHtml(h.url)}" data-selected="${i === activeIndex}" aria-selected="${i === activeIndex}" role="option">
          <div class="search-hit-title">${escapeHtml(h.title)}</div>
          <div class="search-hit-excerpt">${escapeExcerpt ? escapeHtml(h.excerpt) : h.excerpt}</div>
        </a>`
      )
      .join("");
    syncActiveDescendant();
  }

  function showShortcuts() {
    hits = CORE_SHORTCUTS;
    activeIndex = 0;
    renderHits("Quick links · 5 core docs", true);
  }

  function openModal() {
    if (!modal || !input) return;
    lastFocused = document.activeElement instanceof HTMLElement ? document.activeElement : null;
    modal.hidden = false;
    input.setAttribute("aria-expanded", "true");
    document.body.style.overflow = "hidden";
    if (!input.value.trim()) showShortcuts();
    input.focus();
    input.select();
    ensurePagefind();
  }

  function closeModal() {
    if (!modal) return;
    modal.hidden = true;
    input?.setAttribute("aria-expanded", "false");
    input?.removeAttribute("aria-activedescendant");
    document.body.style.overflow = "";
    lastFocused?.focus();
    lastFocused = null;
  }

  let debounce: ReturnType<typeof setTimeout> | null = null;
  input?.addEventListener("input", () => {
    if (debounce) clearTimeout(debounce);
    const seq = ++querySeq;
    const q = input.value.trim();

    if (!q) {
      showShortcuts();
      return;
    }

    if (!pagefind || pagefindLoading) {
      showEmptyState("Loading search index…", "Loading documentation index…");
    }

    debounce = setTimeout(async () => {
      const pf = await ensurePagefind();
      if (seq !== querySeq) return;
      if (!pf) {
        showEmptyState(
          "Search unavailable",
          `<div>Search is temporarily unavailable. Browse the docs sidebar instead.</div>
           <div class="search-recovery-links">
             <a href="/docs/">All Docs</a>
             <a href="/docs/getting-started/">Getting Started</a>
             <a href="/docs/cli/">CLI Reference</a>
           </div>`
        );
        return;
      }
      const search = await pf.search(q);
      if (seq !== querySeq) return;
      const loaded = await Promise.all(search.results.slice(0, 8).map((r: any) => r.data()));
      if (seq !== querySeq) return;
      hits = loaded.map((d: any) => ({
        url: d.url,
        title: d.meta?.title || d.url,
        excerpt: d.excerpt || "",
      }));
      if (!hits.length) {
        showEmptyState(
          "0 results",
          `<div>No matching pages for “${escapeHtml(q)}”.</div>
           <div class="search-recovery-links">
             <a href="/docs/">Browse Docs</a>
             <a href="/docs/getting-started/">Getting Started</a>
             <a href="/docs/cli/">CLI &amp; Day-2 Ops</a>
           </div>`
        );
        return;
      }
      activeIndex = 0;
      const total = search.results.length;
      renderHits(`${total} ${total === 1 ? "result" : "results"}`, false);
    }, 90);
  });

  openBtn?.addEventListener("click", openModal);
  closeBtn?.addEventListener("click", closeModal);
  modal?.addEventListener("click", (e) => {
    if (e.target === modal) closeModal();
  });

  window.addEventListener("keydown", (e) => {
    const target = e.target as HTMLElement | null;
    const inField = Boolean(
      target && (/INPUT|TEXTAREA|SELECT/.test(target.tagName) || target.isContentEditable)
    );
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
      e.preventDefault();
      if (modal?.hidden) openModal();
      else closeModal();
      return;
    }
    if (!inField && !e.metaKey && !e.ctrlKey && !e.altKey && e.key === "/" && modal?.hidden) {
      e.preventDefault();
      openModal();
      return;
    }
    if (modal && !modal.hidden) {
      if (e.key === "Escape") {
        e.preventDefault();
        closeModal();
      } else if (e.key === "Tab" && dialog) {
        const focusables = Array.from(
          dialog.querySelectorAll<HTMLElement>('input, button, a[href], [tabindex]:not([tabindex="-1"])')
        ).filter((el) => !el.hasAttribute("disabled") && el.offsetParent !== null);
        if (focusables.length) {
          const first = focusables[0];
          const last = focusables[focusables.length - 1];
          if (e.shiftKey && document.activeElement === first) {
            e.preventDefault();
            last.focus();
          } else if (!e.shiftKey && document.activeElement === last) {
            e.preventDefault();
            first.focus();
          }
        }
      } else if (e.key === "ArrowDown" && hits.length) {
        e.preventDefault();
        activeIndex = (activeIndex + 1) % hits.length;
        renderHits(statusEl?.textContent || "", !input?.value.trim());
      } else if (e.key === "ArrowUp" && hits.length) {
        e.preventDefault();
        activeIndex = (activeIndex - 1 + hits.length) % hits.length;
        renderHits(statusEl?.textContent || "", !input?.value.trim());
      } else if (e.key === "Enter" && activeIndex >= 0 && hits[activeIndex]) {
        e.preventDefault();
        window.location.href = hits[activeIndex].url;
      }
    }
  });
</script>
