---
// Zero-framework interactive end-to-end Auditstream protocol workbench (~3.5 KB vanilla JS, 0 KB client Shiki).
// Encodes real RFC 4648 unpadded base64url in the browser and reuses tokens.css .st-* classes for Light/Dark parity.
---

<section class="section wb-section" id="workbench" aria-labelledby="wb-heading">
  <div class="shell">
    <div class="wb-head-row reveal">
      <div>
        <div class="eyebrow"><span class="eyebrow-dot" />LIVE PROTOCOL SIMULATOR · SPEC v0.1</div>
        <h2 class="h2" id="wb-heading" style="margin-top:0.65rem;">Try the wire protocol live.</h2>
      </div>
      <p class="lead" style="max-width:34rem;">
        Pick a scenario or type any <code class="ic">actor.id</code> — even <code class="ic">*/ DROP TABLE --</code> — to watch real unpadded <code class="ic">base64url</code> encoding, byte-cap enforcement, and PostgreSQL trigger capture in action.
      </p>
    </div>

    <div class="plate plate-reg wb-board reveal" id="wb-root">
      <!-- Top controls: presets + editable Actor ID + Run button -->
      <div class="wb-controls">
        <div class="wb-presets" role="group" aria-label="Simulation scenarios">
          <button type="button" class="wb-preset" data-wb-preset="agent" data-active="true" aria-pressed="true">AI Agent (onBehalfOf)</button>
          <button type="button" class="wb-preset" data-wb-preset="inject" data-active="false" aria-pressed="false">Injection test (*/)</button>
          <button type="button" class="wb-preset" data-wb-preset="noop" data-active="false" aria-pressed="false">No-op UPDATE</button>
          <button type="button" class="wb-preset" data-wb-preset="excluded" data-active="false" aria-pressed="false">Excluded password_hash</button>
        </div>

        <div class="wb-input-group">
          <label class="wb-label mono" for="wb-actor-id">actor.id</label>
          <input
            type="text"
            id="wb-actor-id"
            class="wb-input mono"
            value="billing-agent"
            maxlength="140"
            autocomplete="off"
            spellcheck="false"
            aria-describedby="wb-byte-meter"
          />
          <span class="pill pill-after wb-meter" id="wb-byte-meter">86 / 512 B</span>
          <button type="button" class="btn btn-primary wb-run-btn" id="wb-run">Run query ▸</button>
        </div>
      </div>

      <!-- Compact animated pipeline rail (SVG transform-free text, pure stroke-dashoffset pulse!) -->
      <div class="wb-rail-wrap" aria-hidden="true">
        <svg class="wb-rail-svg" viewBox="0 0 900 34" fill="none">
          <line x1="95" y1="17" x2="805" y2="17" stroke="var(--rule-strong)" stroke-width="1" />
          <line id="wb-pulse" class="wb-pulse" x1="95" y1="17" x2="805" y2="17" stroke="var(--accent)" stroke-width="2.5" stroke-dasharray="48 760" stroke-dashoffset="48" />
          <g>
            <rect x="20" y="5" width="150" height="24" fill="var(--plate)" stroke="var(--accent)" stroke-width="1.2" />
            <text x="95" y="20.5" text-anchor="middle" fill="var(--ink)" font-family="IBM Plex Mono, monospace" font-size="9.5">1. ADAPTER (BASE64URL)</text>
          </g>
          <g>
            <rect id="wb-node-pg" x="372" y="5" width="156" height="24" fill="var(--plate)" stroke="var(--rule-strong)" stroke-width="1.2" />
            <text x="450" y="20.5" text-anchor="middle" fill="var(--ink-2)" font-family="IBM Plex Mono, monospace" font-size="9.5">2. PG TRIGGER DIFF</text>
          </g>
          <g>
            <rect id="wb-node-out" x="720" y="5" width="160" height="24" fill="var(--plate)" stroke="var(--rule-strong)" stroke-width="1.2" />
            <text id="wb-node-out-txt" x="800" y="20.5" text-anchor="middle" fill="var(--ink-2)" font-family="IBM Plex Mono, monospace" font-size="9.5">3. AUDITSTREAM.CHANGES</text>
          </g>
        </svg>
      </div>

      <!-- Two locked-height synchronized panes -->
      <div class="wb-panes">
        <div class="wb-pane">
          <div class="wb-pane-head">
            <span>OUTBOUND SQL STATEMENT</span>
            <span id="wb-safety-badge" class="pill pill-after">SAFE · ZERO */ BREAKOUT</span>
          </div>
          <pre class="shiki wb-code" id="wb-sql-out" aria-live="polite"></pre>
          <div class="wb-pane-foot mono">
            <span id="wb-json-preview"></span>
          </div>
        </div>

        <div class="wb-pane">
          <div class="wb-pane-head">
            <span>POSTGRESQL CAPTURE RESULT</span>
            <span id="wb-result-badge" class="pill pill-accent">1 ROW COMMITTED</span>
          </div>
          <pre class="shiki wb-code" id="wb-pg-out" aria-live="polite"></pre>
          <div class="wb-pane-foot mono">
            <span id="wb-result-note"></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .wb-section {
    padding-block: clamp(3rem, 5vw, 4.75rem);
  }

  .wb-head-row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.25rem 2.5rem;
  }

  .wb-board {
    margin-top: 1.75rem;
  }

  .wb-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1rem;
    padding: 0.75rem 0.95rem;
    border-bottom: 1px solid var(--rule);
    background: var(--plate-2);
  }

  .wb-presets {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .wb-preset {
    height: 1.9rem;
    padding: 0 0.65rem;
    border: 1px solid var(--rule);
    background: var(--plate);
    color: var(--ink-2);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    transition: border-color var(--dur-quick), color var(--dur-quick), background-color var(--dur-quick);
  }

  .wb-preset:hover {
    border-color: var(--rule-strong);
    color: var(--ink);
  }

  .wb-preset[data-active="true"] {
    border-color: var(--accent);
    background: var(--accent-soft);
    color: var(--accent);
    font-weight: 500;
  }

  .wb-input-group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .wb-label {
    font-size: 0.7rem;
    color: var(--ink-3);
  }

  .wb-input {
    height: 1.95rem;
    width: clamp(11rem, 18vw, 15.5rem);
    padding: 0 0.55rem;
    border: 1px solid var(--rule-strong);
    background: var(--plate);
    color: var(--ink);
    font-size: 0.74rem;
  }

  .wb-input:focus {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }

  .wb-meter {
    min-width: 5.5rem;
    justify-content: center;
  }

  .wb-run-btn {
    height: 1.95rem;
    padding: 0 0.85rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .wb-rail-wrap {
    padding: 0.55rem 0.95rem;
    border-bottom: 1px solid var(--rule);
    background: color-mix(in srgb, var(--plate-2) 55%, var(--plate));
  }

  .wb-rail-svg {
    width: 100%;
    height: 34px;
    display: block;
  }

  .wb-pulse {
    opacity: 0;
  }

  .wb-pulse.is-firing {
    opacity: 1;
    animation: wb-travel 420ms var(--ease-smooth-out) forwards;
  }

  @keyframes wb-travel {
    from { stroke-dashoffset: 48; }
    to { stroke-dashoffset: -710; }
  }

  .wb-panes {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  @media (min-width: 960px) {
    .wb-panes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .wb-pane {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .wb-pane:first-child {
    border-bottom: 1px solid var(--rule);
  }

  @media (min-width: 960px) {
    .wb-pane:first-child {
      border-bottom: 0;
      border-right: 1px solid var(--rule);
    }
  }

  .wb-pane-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.48rem 0.95rem;
    border-bottom: 1px solid var(--rule);
    background: var(--plate-2);
    font-family: var(--font-mono);
    font-size: 0.67rem;
    letter-spacing: 0.07em;
    color: var(--ink-3);
  }

  .wb-code {
    min-height: 11.2rem;
    padding: 0.85rem 0.95rem;
    flex: 1 1 auto;
    white-space: pre;
    overflow-x: auto;
  }

  .wb-pane-foot {
    padding: 0.48rem 0.95rem;
    border-top: 1px solid var(--rule);
    background: color-mix(in srgb, var(--plate-2) 65%, var(--plate));
    font-size: 0.69rem;
    color: var(--ink-3);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (max-width: 640px) {
    .wb-rail-wrap { display: none; }
  }
</style>

<script>
  const PRESETS: Record<string, {
    actorType: string;
    defaultId: string;
    onBehalfOf?: { type: string; id: string };
    tenant?: string;
    table: string;
    sql: string[];
    outcome: "commit" | "noop" | "excluded";
  }> = {
    agent: {
      actorType: "ai_agent",
      defaultId: "billing-agent",
      onBehalfOf: { type: "user", id: "usr_42" },
      tenant: "org_acme",
      table: "public.invoice",
      sql: [
        '<span class="st-kw">UPDATE</span> public.invoice',
        '<span class="st-kw">SET</span>    status = <span class="st-str">\'paid\'</span>',
        '<span class="st-kw">WHERE</span>  id = <span class="st-str">\'inv_901\'</span>',
      ],
      outcome: "commit",
    },
    inject: {
      actorType: "user",
      defaultId: "usr_42 */ DROP TABLE invoice; --",
      tenant: "org_acme",
      table: "public.invoice",
      sql: [
        '<span class="st-kw">UPDATE</span> public.invoice',
        '<span class="st-kw">SET</span>    status = <span class="st-str">\'paid\'</span>',
        '<span class="st-kw">WHERE</span>  id = <span class="st-str">\'inv_901\'</span>',
      ],
      outcome: "commit",
    },
    noop: {
      actorType: "user",
      defaultId: "usr_42",
      table: "public.invoice",
      sql: [
        '<span class="st-kw">UPDATE</span> public.invoice',
        '<span class="st-kw">SET</span>    status = <span class="st-str">\'open\'</span>  <span class="st-cm">-- unchanged</span>',
        '<span class="st-kw">WHERE</span>  id = <span class="st-str">\'inv_901\'</span>',
      ],
      outcome: "noop",
    },
    excluded: {
      actorType: "user",
      defaultId: "usr_42",
      table: "public.users",
      sql: [
        '<span class="st-kw">UPDATE</span> public.users',
        '<span class="st-kw">SET</span>    password_hash = <span class="st-num">$1</span>  <span class="st-cm">-- --exclude col</span>',
        '<span class="st-kw">WHERE</span>  id = <span class="st-str">\'usr_42\'</span>',
      ],
      outcome: "excluded",
    },
  };

  const encoder = new TextEncoder();
  const actorInput = document.getElementById("wb-actor-id") as HTMLInputElement | null;
  const meterEl = document.getElementById("wb-byte-meter");
  const safetyBadge = document.getElementById("wb-safety-badge");
  const resultBadge = document.getElementById("wb-result-badge");
  const sqlOut = document.getElementById("wb-sql-out");
  const pgOut = document.getElementById("wb-pg-out");
  const jsonPrev = document.getElementById("wb-json-preview");
  const resultNote = document.getElementById("wb-result-note");
  const pulseEl = document.getElementById("wb-pulse");
  const nodePg = document.getElementById("wb-node-pg");
  const nodeOut = document.getElementById("wb-node-out");
  const runBtn = document.getElementById("wb-run");
  const presetBtns = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-wb-preset]"));

  let currentPreset = "agent";
  let xactCounter = 48291044;
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  function esc(s: string): string {
    return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
  }

  function toBase64UrlUnpadded(bytes: Uint8Array): string {
    let bin = "";
    for (let i = 0; i < bytes.length; i++) bin += String.fromCharCode(bytes[i]);
    return btoa(bin).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "");
  }

  function firePulse(accentVar: string) {
    if (reduceMotion || !pulseEl) return;
    pulseEl.setAttribute("stroke", accentVar);
    pulseEl.classList.remove("is-firing");
    void pulseEl.getBoundingClientRect();
    pulseEl.classList.add("is-firing");
    nodePg?.setAttribute("stroke", "var(--accent)");
    nodeOut?.setAttribute("stroke", accentVar);
    window.setTimeout(() => {
      nodePg?.setAttribute("stroke", "var(--rule-strong)");
      nodeOut?.setAttribute("stroke", "var(--rule-strong)");
    }, 520);
  }

  function renderWorkbench(triggerPulse: boolean) {
    const cfg = PRESETS[currentPreset];
    if (!cfg || !sqlOut || !pgOut) return;
    const rawId = (actorInput?.value || "").trim() || cfg.defaultId;
    const payload: Record<string, unknown> = { type: cfg.actorType, id: rawId };
    if (cfg.onBehalfOf) payload.onBehalfOf = cfg.onBehalfOf;
    if (cfg.tenant) payload.tenant = cfg.tenant;

    const json = JSON.stringify(payload);
    const bytes = encoder.encode(json);
    const b64 = toBase64UrlUnpadded(bytes);
    const overCap = bytes.byteLength > 512;
    const hasBreakoutInput = rawId.includes("*/") || rawId.includes("--") || rawId.includes("'");

    if (meterEl) {
      meterEl.textContent = `${bytes.byteLength} / 512 B`;
      meterEl.className = `pill wb-meter ${overCap ? "pill-before" : "pill-after"}`;
    }
    if (safetyBadge) {
      if (overCap) {
        safetyBadge.textContent = "PAYLOAD_TOO_LARGE (> 512 B)";
        safetyBadge.className = "pill pill-before";
      } else if (hasBreakoutInput) {
        safetyBadge.textContent = "*/ NEUTRALIZED IN BASE64URL";
        safetyBadge.className = "pill pill-after";
      } else {
        safetyBadge.textContent = "SAFE · ZERO */ BREAKOUT";
        safetyBadge.className = "pill pill-after";
      }
    }

    const displayB64 = b64.length > 42 ? `${b64.slice(0, 26)}…${b64.slice(-12)}` : b64;
    sqlOut.innerHTML = [
      ...cfg.sql,
      `<mark class="tok-audit">/*auditstream='${esc(displayB64)}'*/</mark>;`,
      `<span class="st-cm">-- base64url chars: ${b64.length}/683 · alphabet [A-Za-z0-9-_]</span>`,
    ]
      .map((line, i) => `<span class="line"><span class="ln">${i + 1}</span>${line}</span>`)
      .join("\n");

    if (jsonPrev) jsonPrev.textContent = `canonical json: ${json}`;

    if (overCap) {
      if (resultBadge) {
        resultBadge.textContent = "BLOCKED IN ADAPTER";
        resultBadge.className = "pill pill-before";
      }
      pgOut.innerHTML = [
        `<span class="st-del">AuditstreamError [PAYLOAD_TOO_LARGE]</span>`,
        `<span class="st-cm">-- thrown before SQL is sent to Postgres</span>`,
        `bytes : <span class="st-num">${bytes.byteLength}</span> (spec 0.1.0 limit: <span class="st-num">512</span>)`,
      ]
        .map((line, i) => `<span class="line"><span class="ln">${i + 1}</span>${line}</span>`)
        .join("\n");
      if (resultNote) resultNote.textContent = "Adapter enforces 512-byte cap before executing query.";
      if (triggerPulse) firePulse("var(--before)");
      return;
    }

    if (cfg.outcome === "noop") {
      if (resultBadge) {
        resultBadge.textContent = "SKIPPED · 0 ROWS";
        resultBadge.className = "pill pill-hold";
      }
      pgOut.innerHTML = [
        `<span class="st-cm">-- WHEN (OLD.* IS DISTINCT FROM NEW.*) = false</span>`,
        `trigger : <span class="st-prop">not fired (zero work)</span>`,
        `table   : <span class="st-str">${cfg.table}</span>`,
        `written : <span class="st-num">0</span> audit rows`,
      ]
        .map((line, i) => `<span class="line"><span class="ln">${i + 1}</span>${line}</span>`)
        .join("\n");
      if (resultNote) resultNote.textContent = "No-op updates never pollute auditstream.changes.";
      if (triggerPulse) firePulse("var(--hold)");
      return;
    }

    if (cfg.outcome === "excluded") {
      if (resultBadge) {
        resultBadge.textContent = "REDACTED · 0 ROWS";
        resultBadge.className = "pill pill-after";
      }
      pgOut.innerHTML = [
        `<span class="st-cm">-- excluded column stripped before diff</span>`,
        `excluded: <span class="st-str">["password_hash"]</span>`,
        `changed : <span class="st-num">[]</span> (empty after redaction)`,
        `written : <span class="st-num">0</span> audit rows (secret never stored)`,
      ]
        .map((line, i) => `<span class="line"><span class="ln">${i + 1}</span>${line}</span>`)
        .join("\n");
      if (resultNote) resultNote.textContent = "Excluded-only updates exit before resolve_actor() even runs.";
      if (triggerPulse) firePulse("var(--after)");
      return;
    }

    if (triggerPulse) xactCounter += 1;
    if (resultBadge) {
      resultBadge.textContent = `COMMITTED · xact_id ${xactCounter}`;
      resultBadge.className = "pill pill-accent";
    }
    const shortId = rawId.length > 28 ? `${rawId.slice(0, 26)}…` : rawId;
    const delegateLine = cfg.onBehalfOf
      ? `delegate: <span class="st-str">"${cfg.onBehalfOf.type}:${cfg.onBehalfOf.id}"</span>`
      : `source  : <span class="st-str">"comment"</span> <span class="st-cm">(zero POSIX regex)</span>`;
    pgOut.innerHTML = [
      `actor   : <span class="st-str">"${esc(cfg.actorType)}:${esc(shortId)}"</span>`,
      delegateLine,
      `<span class="tok-del">− before: { "status": "open" }</span>`,
      `<span class="tok-add">+ after : { "status": "paid" }</span>`,
      `ledger  : <span class="st-kw">auditstream.changes</span> (xid8=<span class="st-num">${xactCounter}</span>)`,
    ]
      .map((line, i) => `<span class="line"><span class="ln">${i + 1}</span>${line}</span>`)
      .join("\n");
    if (resultNote) {
      resultNote.textContent = hasBreakoutInput
        ? "Decoded safely as literal JSON string — SQL comment was never closed."
        : "Committed atomically in the same transaction; app role has SELECT only.";
    }
    if (triggerPulse) firePulse("var(--after)");
  }

  presetBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      const key = btn.getAttribute("data-wb-preset") || "agent";
      currentPreset = key;
      presetBtns.forEach((b) => {
        const active = b === btn;
        b.setAttribute("data-active", String(active));
        b.setAttribute("aria-pressed", String(active));
      });
      if (actorInput && PRESETS[key]) actorInput.value = PRESETS[key].defaultId;
      renderWorkbench(true);
    });
  });

  actorInput?.addEventListener("input", () => renderWorkbench(false));
  runBtn?.addEventListener("click", () => renderWorkbench(true));
  renderWorkbench(false);
</script>
