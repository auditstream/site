---
import BrandMark from "./BrandMark.astro";

interface Props {
  currentPath?: string;
}
const { currentPath = "/" } = Astro.props;
const isDocs = currentPath.startsWith("/docs");
---

<header class="nav">
  <div class="shell nav-inner">
    <a href={isDocs ? "/" : "#top"} class="brand" aria-label="Auditstream home">
      <BrandMark size={22} />
      <span>auditstream</span>
      <span class="brand-tag">v0.1</span>
    </a>

    <nav class="nav-links" aria-label="Primary">
      <a href="/#attribution">Adapters</a>
      <a href="/#history">Changes</a>
      <a href="/#export">xid8 Cursor</a>
      <a href="/#datasheet">Evidence</a>
      <a href="/docs" aria-current={isDocs ? "page" : undefined}>Docs</a>
      <a href="https://github.com/auditstream/auditstream" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true" style="font-size:0.75em;color:var(--ink-3);">↗</span></a>
    </nav>

    <div class="nav-actions">
      <button type="button" class="chip-btn" id="open-search" aria-label="Search documentation">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="8" />
          <path d="m21 21-4.3-4.3" />
        </svg>
        <span class="hide-sm">Search</span>
        <span class="kbd-hint">⌘K</span>
      </button>
      <button type="button" class="chip-btn" id="btn-mode" aria-label="Toggle color mode">
        <svg class="icon-sun" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
        </svg>
        <svg class="icon-moon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
        <span id="mode-label" class="hide-sm">Light</span>
        <span class="kbd-hint">L</span>
      </button>
      {!isDocs && (
        <a href="/docs" class="chip-btn show-sm-only">Docs</a>
      )}
    </div>
  </div>
</header>

<style>
  .show-sm-only {
    display: none;
  }
  @media (max-width: 900px) {
    .show-sm-only {
      display: inline-flex;
    }
  }
</style>
