---
interface Props {
  size?: number;
}
const { size = 22 } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 28 28" fill="none" aria-hidden="true">
  <rect x="2" y="3" width="24" height="5" stroke="currentColor" stroke-width="1.6" />
  <rect x="2" y="11.5" width="16" height="5" stroke="var(--accent)" stroke-width="1.6" />
  <path
    d="M21 14H26M23.5 11.5L26 14L23.5 16.5"
    stroke="var(--accent)"
    stroke-width="1.6"
    stroke-linecap="square"
  />
  <rect x="2" y="20" width="24" height="5" stroke="currentColor" stroke-width="1.6" opacity="0.5" />
</svg>
