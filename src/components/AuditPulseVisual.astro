<script>
  type Phase = "1" | "2" | "3";

  const card = document.getElementById("audit-pulse-visual");
  if (card) {
    const DURATIONS: Record<Phase, number> = { "1": 2400, "2": 1900, "3": 3500 };
    const NEXT: Record<Phase, Phase> = { "1": "2", "2": "3", "3": "1" };
    const INITIAL_HOLD = 1200;

    const buttons = Array.from(card.querySelectorAll<HTMLButtonElement>("[data-phase-btn]"));
    const reducedQuery = window.matchMedia("(prefers-reduced-motion: reduce)");

    let phase: Phase = "3";
    let started = false;
    let inView = false;
    let hovered = false;
    let focused = false;
    let timerId: number | null = null;
    let phaseStart = 0;
    let remaining = INITIAL_HOLD;

    const isPaused = () => !inView || hovered || focused || document.hidden;

    function applyPhase(nextPhase: Phase, forceReplay: boolean) {
      phase = nextPhase;
      if (forceReplay && nextPhase === "2") {
        card.removeAttribute("data-phase");
        void card.offsetWidth;
      }
      card.setAttribute("data-phase", nextPhase);
      buttons.forEach((btn) => {
        btn.setAttribute("aria-pressed", String(btn.getAttribute("data-phase-btn") === nextPhase));
      });
    }

    function clearTimer() {
      if (timerId !== null) {
        window.clearTimeout(timerId);
        timerId = null;
      }
    }

    function pause() {
      if (timerId !== null) {
        clearTimer();
        remaining = Math.max(80, remaining - (performance.now() - phaseStart));
      }
      card.classList.add("is-paused");
    }

    function schedule() {
      clearTimer();
      if (reducedQuery.matches || !started || isPaused()) {
        card.classList.add("is-paused");
        return;
      }
      card.classList.remove("is-paused");
      phaseStart = performance.now();
      timerId = window.setTimeout(() => {
        timerId = null;
        const next = NEXT[phase];
        applyPhase(next, false);
        remaining = DURATIONS[next];
        schedule();
      }, Math.max(0, remaining));
    }

    function sync() {
      if (reducedQuery.matches) {
        clearTimer();
        card.classList.remove("is-paused");
        return;
      }
      if (!started) {
        if (inView && !document.hidden) {
          started = true;
          remaining = INITIAL_HOLD;
        } else {
          return;
        }
      }
      if (isPaused()) pause();
      else schedule();
    }

    // Interactive step controls work both during normal playback and under prefers-reduced-motion
    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const target = btn.getAttribute("data-phase-btn");
        if (target !== "1" && target !== "2" && target !== "3") return;
        clearTimer();
        started = true;
        applyPhase(target, true);
        remaining = DURATIONS[target];
        if (!reducedQuery.matches && !isPaused()) {
          schedule();
        } else if (!reducedQuery.matches) {
          // Ensure phase 2 SVG motion replays cleanly even when hovered/focused by clicking step 2
          card.classList.remove("is-paused");
        }
      });
    });

    card.addEventListener("pointerenter", () => {
      hovered = true;
      sync();
    });

    card.addEventListener("pointerleave", () => {
      hovered = false;
      sync();
    });

    card.addEventListener("focusin", () => {
      focused = true;
      sync();
    });

    card.addEventListener("focusout", (e) => {
      if (!card.contains(e.relatedTarget as Node | null)) {
        focused = false;
        sync();
      }
    });

    document.addEventListener("visibilitychange", sync);
    reducedQuery.addEventListener("change", sync);

    if ("IntersectionObserver" in window) {
      new IntersectionObserver(
        (entries) => {
          inView = Boolean(entries[0]?.isIntersecting);
          sync();
        },
        { threshold: 0.15 }
      ).observe(card);
    } else {
      inView = true;
      sync();
    }
  }
</script>
