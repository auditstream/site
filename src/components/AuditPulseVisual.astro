---
// Single spacious Retina focal micro-motion — pure DOM IBM Plex Mono/Sans + inline SVG bridge.
// Interruptible 7.8s JS data-phase="1"|"2"|"3" state machine (2.4s / 1.9s / 3.5s) with genuine
// 420–460ms CSS transitions, separated 2-layer one-shot SVG packet travel, SSR-settled initial
// paint (data-phase="3"), accurate pause/resume, and interactive step controls even under reduced motion.
---

<figure
  class="ap-card"
  id="audit-pulse-visual"
  data-phase="3"
  aria-label="Live capture flow: 1. Tag query attaches an auditstream SQL comment to an UPDATE, 2. Trigger fires inside PostgreSQL within the same xid8 transaction, and 3. Diff recorded stamps an immutable before-and-after row into auditstream.changes."
>
  <div class="ap-chrome">
    <ol class="ap-steps" aria-label="Capture sequence">
      <li>
        <button
          type="button"
          class="ap-step"
          data-phase-btn="1"
          aria-pressed="false"
        >1. Tag query</button>
      </li>
      <li class="ap-step-sep" aria-hidden="true">→</li>
      <li>
        <button
          type="button"
          class="ap-step"
          data-phase-btn="2"
          aria-pressed="false"
        >2. Trigger fires</button>
      </li>
      <li class="ap-step-sep" aria-hidden="true">→</li>
      <li>
        <button
          type="button"
          class="ap-step"
          data-phase-btn="3"
          aria-pressed="true"
        >3. Diff recorded</button>
      </li>
    </ol>
    <span class="ap-chrome-right">PostgreSQL 15–19 · Zero daemon</span>
  </div>

  <div class="ap-stage">
    <!-- Left Pane: Phase 1 — Application Write -->
    <div class="ap-pane ap-pane-left">
      <div class="ap-pane-head">
        <span class="ap-pane-label ap-label-left">APPLICATION WRITE</span>
      </div>

      <div class="ap-sql" role="presentation">
        <div class="ap-sql-line">
          <span class="st-kw">UPDATE</span> <span class="st-fg">invoice</span>
        </div>
        <div class="ap-sql-line">
          <span class="st-kw">SET</span>    <span class="st-fg">status</span> <span class="st-punc">=</span> <span class="st-str">'paid'</span>
        </div>
        <div class="ap-sql-line">
          <span class="st-kw">WHERE</span>  <span class="st-fg">id</span> <span class="st-punc">=</span> <span class="st-str">'inv_901'</span>
        </div>
        <div class="ap-sql-line ap-sql-comment-row">
          <span class="ap-comment-pill">/*auditstream='eyJ0eXBlIjoiYWlf…'*/</span>
        </div>
      </div>

      <div class="ap-pane-foot ap-pane-foot-left">
        <span class="ap-actor-bar">
          <span class="ap-actor-bar-content">
            <span class="ap-foot-strong">ai_agent:billing-agent</span>
            <span class="ap-onbehalf"><span aria-hidden="true">→</span> onBehalfOf user:usr_42</span>
          </span>
        </span>
      </div>
    </div>

    <!-- Center Bridge: Phase 2 — Crisp Inline SVG Track + 2-Leg Moving Packets + PG Trigger Pill -->
    <div class="ap-bridge" aria-hidden="true">
      <!-- Mobile vertical 2-leg vector bridge (< 820px) -->
      <svg class="ap-svg-v" viewBox="0 0 28 56" fill="none">
        <circle cx="14" cy="4" r="2.5" class="ap-track-node" />
        <line x1="14" y1="6" x2="14" y2="50" class="ap-track-line" />
        <path d="M9.75 45.5L14 51.75L18.25 45.5" class="ap-track-arrow" />

        <!-- Leg 1 (Cobalt): top -> center hub (cy=28) -->
        <line x1="14" y1="6" x2="14" y2="24" pathLength="100" class="ap-pulse-v-in" />
        <g class="ap-packet-v-in-pos">
          <g class="ap-packet-v-in-vis">
            <rect x="10.5" y="-5" width="7" height="10" rx="3.5" class="ap-packet-cobalt" />
            <circle cx="14" cy="2" r="1.4" class="ap-packet-core" />
          </g>
        </g>

        <!-- Leg 2 (Emerald): center hub (cy=28) -> bottom -->
        <line x1="14" y1="32" x2="14" y2="50" pathLength="100" class="ap-pulse-v-out" />
        <g class="ap-packet-v-out-pos">
          <g class="ap-packet-v-out-vis">
            <rect x="10.5" y="-5" width="7" height="10" rx="3.5" class="ap-packet-emerald" />
            <circle cx="14" cy="2" r="1.4" class="ap-packet-core" />
          </g>
        </g>

        <!-- Center trigger intercept hub -->
        <circle cx="14" cy="28" r="4" class="ap-hub-node" />
      </svg>

      <div class="ap-trigger-group">
        <div class="ap-track-row">
          <!-- Desktop unobstructed horizontal 2-leg vector bus with center trigger tap -->
          <svg class="ap-svg-h" viewBox="0 0 140 34" fill="none">
            <circle cx="4" cy="14" r="2.5" class="ap-track-node" />
            <line x1="6" y1="14" x2="132" y2="14" class="ap-track-line" />
            <path d="M126.5 9.75L133.25 14L126.5 18.25" class="ap-track-arrow" />
            <line x1="70" y1="18" x2="70" y2="34" class="ap-track-stem" />

            <!-- Leg 1 (Cobalt): Left pane -> center trigger node (cx=70) -->
            <line x1="6" y1="14" x2="66" y2="14" pathLength="100" class="ap-pulse-in" />
            <g class="ap-packet-in-pos">
              <g class="ap-packet-in-vis">
                <rect x="-7" y="9.5" width="14" height="9" rx="4.5" class="ap-packet-cobalt" />
                <circle cx="3" cy="14" r="1.7" class="ap-packet-core" />
              </g>
            </g>

            <!-- Leg 2 (Emerald): center trigger node (cx=70) -> auditstream.changes -->
            <line x1="74" y1="14" x2="132" y2="14" pathLength="100" class="ap-pulse-out" />
            <g class="ap-packet-out-pos">
              <g class="ap-packet-out-vis">
                <rect x="-7" y="9.5" width="14" height="9" rx="4.5" class="ap-packet-emerald" />
                <circle cx="3" cy="14" r="1.7" class="ap-packet-core" />
              </g>
            </g>

            <!-- Center trigger intercept hub -->
            <circle cx="70" cy="14" r="4.5" class="ap-hub-node" />
          </svg>

          <span class="ap-trigger-pill">PG Trigger</span>
        </div>
        <span class="ap-trigger-sub">same xid8</span>
      </div>
    </div>

    <!-- Right Pane: Phase 3 — Quiet Waiting Slot -> Stamped Immutable Audit Row -->
    <div class="ap-pane ap-pane-right">
      <div class="ap-pane-head">
        <span class="ap-pane-label">auditstream.changes</span>
        <span class="ap-status">
          <span class="ap-status-icon" aria-hidden="true">
            <span class="ap-status-dot"></span>
            <svg class="ap-check-svg" width="13" height="13" viewBox="0 0 16 16" fill="none">
              <path
                class="ap-check-path"
                d="M3.2 8.4L6.6 11.8L12.8 4.6"
                pathLength="100"
                stroke="currentColor"
                stroke-width="2.2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </span>
          <span class="ap-status-labels">
            <span class="ap-status-lbl ap-status-lbl-1">Pending</span>
            <span class="ap-status-lbl ap-status-lbl-2">Capturing</span>
            <span class="ap-status-lbl ap-status-lbl-3">Recorded</span>
          </span>
        </span>
      </div>

      <div class="ap-ledger-slot">
        <!-- Visible during Phases 1 & 2, fades smoothly as the committed row reveals -->
        <div class="ap-waiting" aria-hidden="true">
          <span class="ap-waiting-title">Waiting for commit…</span>
          <span class="ap-waiting-sub">Pending trigger inside same xid8</span>
        </div>

        <!-- Reveals smoothly during Phase 3 with crisp reversible stagger -->
        <div class="ap-record">
          <div class="ap-record-head">
            <div class="ap-record-meta">public.invoice · inv_901 · UPDATE</div>
            <div class="ap-record-actor">
              <strong class="ap-actor-main">ai_agent:billing-agent</strong>
              <span class="ap-actor-sub"> · for user:usr_42</span>
            </div>
          </div>

          <div class="ap-diffs">
            <div class="ap-diff ap-diff-del">
              <span class="ap-diff-sign" aria-hidden="true">−</span>
              <span>status: "open"</span>
            </div>
            <div class="ap-diff ap-diff-add">
              <span class="ap-diff-sign" aria-hidden="true">+</span>
              <span>status: "paid"</span>
            </div>
          </div>
        </div>
      </div>

      <div class="ap-pane-foot">
        <span>SELECT-only app role · 0 pooler leaks</span>
      </div>
    </div>
  </div>
</figure>

<style>
  .ap-card {
    --ap-ease-io: cubic-bezier(0.4, 0, 0.2, 1);
    --ap-ease-sine: cubic-bezier(0.37, 0, 0.63, 1);
    width: 100%;
    max-width: 60rem;
    margin: clamp(2rem, 4vw, 3rem) auto 0;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-focal);
    overflow: hidden;
    text-align: left;
  }

  /* Top Chrome 3-Step Interactive Progress Strip */
  .ap-chrome {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    padding: 0.6rem 1.25rem;
    border-bottom: 1px solid var(--rule);
    background: var(--ground-2);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-3);
  }

  .ap-steps {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.25rem 0.35rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .ap-steps > li {
    display: inline-flex;
    align-items: center;
  }

  .ap-step {
    display: inline-flex;
    align-items: center;
    padding: 0.16rem 0.52rem;
    border-radius: var(--radius-pill);
    border: 1px solid transparent;
    background: transparent;
    color: var(--ink-3);
    font-weight: 500;
    line-height: 1.35;
    white-space: nowrap;
    /* Crisp exit (0ms delay) so outgoing pill relaxes cleanly before incoming illuminates */
    transition:
      color 160ms var(--ap-ease-io) 0ms,
      background-color 160ms var(--ap-ease-io) 0ms,
      border-color 160ms var(--ap-ease-io) 0ms;
  }

  .ap-step:hover {
    color: var(--ink);
    border-color: var(--rule-strong);
  }

  /* Mutually exclusive 3-beat step pills: Cobalt -> Crisp Slate -> Emerald */
  .ap-card[data-phase="1"] [data-phase-btn="1"],
  .ap-card[data-phase="2"] [data-phase-btn="2"],
  .ap-card[data-phase="3"] [data-phase-btn="3"] {
    transition:
      color 260ms var(--ap-ease-io) 120ms,
      background-color 260ms var(--ap-ease-io) 120ms,
      border-color 260ms var(--ap-ease-io) 120ms;
  }

  .ap-card[data-phase="1"] [data-phase-btn="1"] {
    color: var(--accent);
    background: var(--accent-soft);
    border-color: var(--accent-border);
  }

  .ap-card[data-phase="2"] [data-phase-btn="2"] {
    color: var(--ink);
    background: var(--surface);
    border-color: var(--rule-strong);
  }

  .ap-card[data-phase="3"] [data-phase-btn="3"] {
    color: var(--after);
    background: var(--after-bg);
    border-color: var(--after-border);
  }

  .ap-step-sep {
    color: var(--ink-3);
    opacity: 0.55;
    user-select: none;
  }

  .ap-chrome-right {
    font-size: 0.75rem;
    color: var(--ink-3);
    white-space: nowrap;
  }

  /* Main 3-Column Stage — pure gallery paper, zero pane washes */
  .ap-stage {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 112px minmax(0, 1fr);
    align-items: stretch;
  }

  .ap-pane {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 1.5rem 1.65rem;
    min-width: 0;
  }

  .ap-pane-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    min-height: 1.75rem;
  }

  .ap-pane-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--ink-3);
    transition: color 420ms var(--ap-ease-io);
  }

  .ap-card[data-phase="1"] .ap-label-left {
    color: var(--accent);
  }

  /* Left Pane SQL Block */
  .ap-sql {
    margin: 1rem 0 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.84375rem;
    line-height: 1.78;
    font-variant-numeric: tabular-nums;
    font-variant-ligatures: none;
    overflow-x: auto;
    scrollbar-width: thin;
  }

  .ap-sql .st-kw { color: var(--st-kw); font-weight: 500; }
  .ap-sql .st-fg { color: var(--st-fg); }
  .ap-sql .st-str { color: var(--st-str); }
  .ap-sql .st-punc { color: var(--st-punc); }

  .ap-sql-line { white-space: pre; }

  .ap-sql-comment-row {
    margin-top: 0.35rem;
    white-space: normal;
  }

  .ap-comment-pill {
    display: inline-block;
    max-width: 100%;
    padding: 0.16rem 0.5rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--accent-border);
    background: var(--accent-soft);
    color: var(--accent);
    font-weight: 500;
    white-space: nowrap;
    overflow-x: auto;
    scrollbar-width: none;
    transition:
      border-color 420ms var(--ap-ease-io),
      background-color 420ms var(--ap-ease-io),
      color 420ms var(--ap-ease-io);
  }

  .ap-comment-pill::-webkit-scrollbar {
    display: none;
  }

  .ap-card[data-phase="1"] .ap-comment-pill {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 13%, var(--surface));
  }

  /* Left Actor Footer Highlight */
  .ap-actor-bar {
    display: inline-flex;
    align-items: center;
    max-width: 100%;
    padding: 0.2rem 0.5rem;
    margin-left: -0.5rem;
    border-radius: var(--radius-sm);
    border: 1px solid transparent;
    background: transparent;
    transition:
      border-color 420ms var(--ap-ease-io),
      background-color 420ms var(--ap-ease-io);
  }

  .ap-card[data-phase="1"] .ap-actor-bar {
    border-color: var(--accent-border);
    background: var(--accent-soft);
  }

  .ap-actor-bar-content {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.4rem;
  }

  .ap-onbehalf {
    white-space: nowrap;
  }

  /* Center SVG Bridge */
  .ap-bridge {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding-block: 1rem;
    z-index: 2;
  }

  .ap-trigger-group {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.45rem;
    width: 100%;
  }

  .ap-track-row {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
  }

  .ap-svg-h {
    display: block;
    width: 140px;
    height: 34px;
    margin-inline: -14px;
    overflow: visible;
    pointer-events: none;
  }

  .ap-svg-v {
    display: none;
    pointer-events: none;
  }

  .ap-track-node { fill: var(--rule-strong); }

  .ap-track-line {
    stroke: var(--rule-strong);
    stroke-width: 1.5;
  }

  .ap-track-stem {
    stroke: var(--rule-strong);
    stroke-width: 1.5;
    transition: stroke 440ms var(--ap-ease-io) 0ms, stroke-width 440ms var(--ap-ease-io) 0ms;
  }

  .ap-card[data-phase="2"] .ap-track-stem {
    stroke: var(--after);
    stroke-width: 2;
    transition-delay: 640ms;
  }

  .ap-hub-node {
    fill: var(--surface);
    stroke: var(--rule-strong);
    stroke-width: 1.5;
    transition: fill 440ms var(--ap-ease-io) 0ms, stroke 440ms var(--ap-ease-io) 0ms;
  }

  .ap-card[data-phase="2"] .ap-hub-node {
    fill: var(--after);
    stroke: var(--after);
    transition-delay: 640ms;
  }

  .ap-track-arrow {
    stroke: var(--rule-strong);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Comets & Separated 2-Layer One-Shot Packets (Phase 2 only) */
  .ap-pulse-in,
  .ap-pulse-v-in {
    stroke: var(--accent);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-dasharray: 38 100;
    stroke-dashoffset: 38;
    opacity: 0;
  }

  .ap-pulse-out,
  .ap-pulse-v-out {
    stroke: var(--after);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-dasharray: 38 100;
    stroke-dashoffset: 38;
    opacity: 0;
  }

  .ap-packet-cobalt { fill: var(--accent); }
  .ap-packet-emerald { fill: var(--after); }
  .ap-packet-core { fill: var(--surface); }

  .ap-packet-in-vis,
  .ap-packet-out-vis,
  .ap-packet-v-in-vis,
  .ap-packet-v-out-vis {
    opacity: 0;
  }

  .ap-card[data-phase="2"] .ap-pulse-in,
  .ap-card[data-phase="2"] .ap-pulse-v-in {
    animation:
      ap-dash-sweep 760ms var(--ap-ease-sine) 80ms 1 both,
      ap-env-pulse 760ms linear 80ms 1 both;
  }

  .ap-card[data-phase="2"] .ap-packet-in-pos {
    animation: ap-move-in-h 760ms var(--ap-ease-sine) 80ms 1 both;
  }

  .ap-card[data-phase="2"] .ap-packet-in-vis {
    animation: ap-env-packet 760ms linear 80ms 1 both;
  }

  .ap-card[data-phase="2"] .ap-packet-v-in-pos {
    animation: ap-move-in-v 760ms var(--ap-ease-sine) 80ms 1 both;
  }

  .ap-card[data-phase="2"] .ap-packet-v-in-vis {
    animation: ap-env-packet 760ms linear 80ms 1 both;
  }

  .ap-card[data-phase="2"] .ap-pulse-out,
  .ap-card[data-phase="2"] .ap-pulse-v-out {
    animation:
      ap-dash-sweep 760ms var(--ap-ease-sine) 900ms 1 both,
      ap-env-pulse 760ms linear 900ms 1 both;
  }

  .ap-card[data-phase="2"] .ap-packet-out-pos {
    animation: ap-move-out-h 760ms var(--ap-ease-sine) 900ms 1 both;
  }

  .ap-card[data-phase="2"] .ap-packet-out-vis {
    animation: ap-env-packet 760ms linear 900ms 1 both;
  }

  .ap-card[data-phase="2"] .ap-packet-v-out-pos {
    animation: ap-move-out-v 760ms var(--ap-ease-sine) 900ms 1 both;
  }

  .ap-card[data-phase="2"] .ap-packet-v-out-vis {
    animation: ap-env-packet 760ms linear 900ms 1 both;
  }

  /* PG Trigger pill — single semantic element, soft Committed Emerald, asymmetric delay */
  .ap-trigger-pill {
    position: relative;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: -1px;
    padding: 0.28rem 0.68rem;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-pill);
    background: var(--surface);
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 500;
    white-space: nowrap;
    transition:
      background-color 440ms var(--ap-ease-io) 0ms,
      border-color 440ms var(--ap-ease-io) 0ms,
      color 440ms var(--ap-ease-io) 0ms;
  }

  .ap-card[data-phase="2"] .ap-trigger-pill {
    background: var(--after-bg);
    border-color: var(--after-border);
    color: var(--after);
    transition-delay: 640ms;
  }

  .ap-trigger-sub {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-3);
    white-space: nowrap;
  }

  /* Right Pane: Persistent Fixed-Width Morphing Status Chip (Zero Blink / Zero Shift) */
  .ap-status {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.16rem 0.62rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius-pill);
    background: var(--ground-2);
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.35;
    white-space: nowrap;
    transition:
      background-color 440ms var(--ap-ease-io),
      border-color 440ms var(--ap-ease-io),
      color 440ms var(--ap-ease-io);
  }

  .ap-card[data-phase="2"] .ap-status {
    background: var(--accent-soft);
    border-color: var(--accent-border);
    color: var(--accent);
  }

  .ap-card[data-phase="3"] .ap-status {
    background: var(--after-bg);
    border-color: var(--after-border);
    color: var(--after);
  }

  .ap-status-icon {
    display: grid;
    place-items: center;
    width: 13px;
    height: 13px;
    flex-shrink: 0;
  }

  .ap-status-icon > * {
    grid-area: 1 / 1;
  }

  .ap-status-dot {
    width: 5px;
    height: 5px;
    border-radius: var(--radius-pill);
    background: currentColor;
    opacity: 0.78;
    transform: scale(1);
    transition:
      opacity 160ms var(--ap-ease-io) 80ms,
      transform 160ms var(--ap-ease-io) 80ms;
  }

  .ap-card[data-phase="3"] .ap-status-dot {
    opacity: 0;
    transform: scale(0.5);
    transition:
      opacity 140ms var(--ap-ease-io) 0ms,
      transform 140ms var(--ap-ease-io) 0ms;
  }

  .ap-check-svg {
    display: block;
  }

  .ap-check-path {
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    opacity: 0;
    transition:
      stroke-dashoffset 140ms var(--ap-ease-io) 0ms,
      opacity 120ms var(--ap-ease-io) 0ms;
  }

